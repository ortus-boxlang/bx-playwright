{
	"name": "BoxLang Playwright",
	"version": "@build.version@+@build.number@",
	"location": "https://downloads.ortussolutions.com/ortussolutions/boxlang-modules/bx-playwright/@build.version@/bx-playwright-@build.version@.zip",
	"author": "Ortus Solutions",
	"homepage": "https://github.com/ortus-boxlang/bx-playwright",
	"documentation": "https://bxplaywright.boxlang.io",
	"repository": {
		"type": "git",
		"URL": "https://github.com/ortus-boxlang/bx-playwright"
	},
	"bugs": "https://ortussolutions.atlassian.net/browse/BLMODULES",
	"slug": "bx-playwright",
	"shortDescription": "Fluent browser automation and testing for BoxLang, powered by Microsoft Playwright",
	"type": "boxlang-modules",
	"keywords": [
		"boxlang",
		"playwright",
		"browser",
		"testing",
		"e2e",
		"automation",
		"pdf",
		"screenshot"
	],
	"boxlang": {
		"minimumVersion": "1.17.0",
		"moduleName": "playwright",
		"executable": "bxPlaywright",
		"completions": "completions/bxPlaywright.bash"
	},
	"private": false,
	"license": [
		{
			"type": "Apache-2.0",
			"URL": "https://www.apache.org/licenses/LICENSE-2.0"
		}
	],
	"devDependencies": {
		"commandbox-boxlang": "*",
		"commandbox-cfformat": "*",
		"commandbox-docbox": "*",
		"testbox": "*"
	},
	"ignore": [
		"**/.*",
		"settings.gradle",
		"gradlew.bat",
		"gradlew",
		"build.gradle",
		"/src/**",
		"gradle/**"
	],
	"scripts": {
		"setupTemplate": "task run taskFile=src/build/SetupTemplate.cfc",
		"onRelease": "publish"
	}
}
