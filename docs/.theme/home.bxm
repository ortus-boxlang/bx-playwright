				</a>
				<a class="eco-card" href="https://commandbox.ortusbooks.com" target="_blank" rel="noopener noreferrer">
					<div class="icon"><img src="#variables.basePath#assets/commandbox-icon.svg" alt="CommandBox"></div><b>CommandBox</b><span>The package manager and CLI for the BoxLang ecosystem.</span>
				</a>
				<a class="eco-card" href="https://bxsites.io" target="_blank" rel="noopener noreferrer">
					<div class="icon"><img src="#variables.basePath#assets/logos/bxsites-icon.svg" alt="bxSites"></div><b>bxSites</b><span>The static site generator that builds this site.</span>
				</a>
			</div>
		</div>
	</section>

	<!--- Section: primary CTA --->
	<section>
		<div class="bxh-wrap">
			<div class="cta">
				<span class="eyebrow">Free &amp; open source</span>
				<h2>Your first browser test in a minute.</h2>
				<p>Install the module, run <code>bxPlaywright install</code>, and drive a real browser from your next BoxLang script.</p>
				<div class="hero-actions">
					<a class="bxh-btn bxh-btn-primary" href="#variables.basePath#getting-started/">Get Started &rarr;</a>
					<a class="bxh-btn bxh-btn-ghost" href="#variables.basePath#browsing/">Read the docs</a>
				</div>
			</div>
		</div>
	</section>

	<!--- Section: professional services CTA --->
	<section>
		<div class="bxh-wrap">
			<div class="cta">
				<a href="https://www.ortussolutions.com" target="_blank" rel="noopener noreferrer"><img class="pw-partner pw-logo-light" src="#variables.basePath#assets/logos/ortus-logo-light.svg" alt="Ortus Solutions"><img class="pw-partner pw-logo-dark" src="#variables.basePath#assets/logos/ortus-logo-dark.svg" alt="Ortus Solutions"></a>
				<span class="eyebrow">Professional open source</span>
				<h2>Free to use, backed by the team that builds it.</h2>
				<p><a href="https://www.ortussolutions.com" target="_blank" rel="noopener noreferrer">Ortus Solutions</a> offers support, training and consulting for test automation, browser testing strategy, CI pipelines and BoxLang applications.</p>
				<div class="hero-actions">
					<a class="bxh-btn bxh-btn-primary" href="mailto:consulting@ortussolutions.com">Email consulting@ortussolutions.com</a>
					<a class="bxh-btn bxh-btn-ghost" href="https://www.ortussolutions.com/services" target="_blank" rel="noopener noreferrer">Professional Services</a>
				</div>
			</div>
		</div>
	</section>

	<!--- Footer: brand, social, link columns, bottom bar --->
	<footer class="bxh-footer">
		<div class="bxh-wrap footer-top">
			<div class="footer-brand">
				<a class="bxh-brand" href="#variables.basePath#">#renderWordmark()#</a>
				<p>Fluent browser automation and testing for BoxLang, powered by Microsoft Playwright.</p>
				<bx:if variables.socialLinks.len() gt 0>
					<div class="social-row">#renderSocialLinks( variables.socialLinks )#</div>
				</bx:if>
				<div class="madeby"><span>Developed by</span> <a href="https://www.ortussolutions.com" target="_blank" rel="noopener noreferrer"><img class="pw-logo-light" src="#variables.basePath#assets/logos/ortus-logo-light.svg" alt="Ortus Solutions"><img class="pw-logo-dark" src="#variables.basePath#assets/logos/ortus-logo-dark.svg" alt="Ortus Solutions"></a></div>
			</div>
			<div class="footer-col">
				<h4>Learn</h4>
				<a href="#variables.basePath#getting-started/">Getting Started</a>
				<a href="#variables.basePath#browsing/">Browsing</a>
				<a href="#variables.basePath#assertions/">Assertions</a>
				<a href="#variables.basePath#testing/">Testing</a>
			</div>
			<div class="footer-col">
				<h4>Reference</h4>
				<a href="#variables.basePath#configuration/">Configuration</a>
				<a href="#variables.basePath#profiles/">Profiles</a>
				<a href="#variables.basePath#cli/">CLI</a>
				<a href="#variables.basePath#errors/">Errors</a>
			</div>
			<div class="footer-col">
				<h4>Get bx-playwright</h4>
				<a href="https://forgebox.io/view/bx-playwright" target="_blank" rel="noopener noreferrer">ForgeBox</a>
				<a href="https://forgebox.io/view/bx-playwright-full" target="_blank" rel="noopener noreferrer">ForgeBox (Full)</a>
				<bx:if len( variables.repoUrl )>
					<a href="#bxsitesUrlAttr( variables.repoUrl )#/releases" target="_blank" rel="noopener noreferrer">GitHub Releases</a>
				</bx:if>
				<a href="#variables.basePath#llms.txt">llms.txt</a>
			</div>
			<div class="footer-col">
				<h4>Community</h4>
				<a href="https://www.ortussolutions.com/community/slack" target="_blank" rel="noopener noreferrer">Slack</a>
				<a href="https://community.ortussolutions.com" target="_blank" rel="noopener noreferrer">Forums</a>
				<bx:if len( variables.repoUrl )>
					<a href="#bxsitesUrlAttr( variables.repoUrl )#/issues" target="_blank" rel="noopener noreferrer">Bug Tracker</a>
				</bx:if>
				<a href="https://www.ortussolutions.com/services" target="_blank" rel="noopener noreferrer">Consulting</a>
			</div>
		</div>
		<div class="bxh-wrap footer-bottom footrow">
			<span>&copy; #year( now() )# Ortus Solutions, Corp</span>
			<div class="footlinks">
				<a class="footverse" href="https://www.bible.com/bible/59/JHN.14.6.ESV" target="_blank" rel="noopener noreferrer"><span aria-hidden="true">&##10084;&##65039;</span> He is the truth and the life</a>
				<a class="poweredby" href="https://boxlang.io" target="_blank" rel="noopener noreferrer">Part of the <b>BoxLang</b> ecosystem</a>
				<a class="builtwith" href="https://bxsites.io" target="_blank" rel="noopener noreferrer"><span>Built with</span><img class="pw-logo-light" src="#variables.basePath#assets/logos/bxsites-logo-light.svg" alt="bxSites"><img class="pw-logo-dark" src="#variables.basePath#assets/logos/bxsites-logo-dark.svg" alt="bxSites"></a>
			</div>
		</div>
	</footer>

	#renderExtraJs( variables.siteConfig.extraJs ?: [] )#
	<!--- Lightbox for the bxSites image galleries --->
	<script src="#moduleAssetUrl( 'image-gallery-init.js' )#" defer></script>
</body>
</html>
</bx:output>
