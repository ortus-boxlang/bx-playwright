<!---
	bx-playwright homepage (`docs/index.md` has `layout: home`). Based on the bx-sites bootstrap
	theme's own home.bxm: the head, header and footer machinery are the theme's, the page content is
	bx-playwright's. The styling comes from bx-sites' shared assets/home.css. Like the original, this
	layout never includes the Markdown body of index.md, which stays for search and llms.txt.
--->
<bx:include template="#variables.moduleAssetsDir#/icons.bxm">
<bx:include template="#variables.moduleAssetsDir#/locale-flags.bxm">
<bx:include template="includes/site-helpers.bxm">
<bx:script>
	// module spec section 7 - search is fully static/client-side (provider "local") by
	// default, opt-out via bxsites.json's `search`; `searchProvider.provider` picks a
	// different provider ("algolia"/"pagefind" built-in here, anything else left to a theme override)
	variables.searchEnabled = ( variables.siteConfig.search ?: false ) ? true : false
	variables.searchProviderName = lCase( trim( variables.siteConfig.searchProvider.provider ?: "local" ) )
	variables.searchAlgolia = variables.siteConfig.searchProvider.algolia ?: {}

	variables.repoUrl = trim( variables.siteConfig.repo.url ?: "" )
	variables.socialLinks = variables.siteConfig.social ?: []
	variables.footerEnabled = ( variables.siteConfig.footer ?: false ) ? true : false
	variables.navCollapsible = ( variables.siteConfig.theme.options.navCollapsible ?: false ) ? true : false
	variables.navExpandAll = ( variables.siteConfig.theme.options.navExpandAll ?: true ) ? true : false
	variables.tocPosition = variables.siteConfig.theme.options.tocPosition ?: "top"
	variables.mainContentClass = variables.tocPosition == "sticky" ? "col-xl-8" : "col-xl-10"
	variables.pageMetaPosition = variables.siteConfig.theme.options.pageMetaPosition ?: "bottom"
	variables.breadcrumbsEnabled = ( variables.siteConfig.theme.options.breadcrumbs ?: true ) ? true : false
	variables.faviconUrl = trim( variables.siteConfig.theme.favicon ?: "" )
	variables.ogImageUrl = len( trim( variables.page.ogImage ?: "" ) ) ? trim( variables.page.ogImage ) : trim( variables.siteConfig.ogImage ?: "" )
	variables.ogDescription = len( variables.page.description ?: "" ) ? variables.page.description : ( variables.siteConfig.description ?: "" )
	variables.analyticsProvider = trim( variables.siteConfig.analytics.provider ?: "" )
	variables.analyticsId = trim( variables.siteConfig.analytics.id ?: "" )
	variables.mermaidEnabled = ( variables.siteConfig.mermaid ?: false ) ? true : false
	variables.mathEnabled = ( variables.siteConfig.math ?: false ) ? true : false
	variables.openapiEnabled = ( variables.siteConfig.openapi ?: false ) ? true : false
	variables.pageActionsEnabled = ( variables.siteConfig.pageActions ?: false ) ? true : false
	variables.pageActionsPosition = variables.siteConfig.theme.options.pageActionsPosition ?: "top"
	variables.accentColor = trim( variables.siteConfig.theme.options.accentColor ?: "" )
	variables.accentColorDark = trim( variables.siteConfig.theme.options.accentColorDark ?: "" )
</bx:script>
<bx:output>
<!doctype html>
<html lang="#encodeForHTML( variables.currentLocale.len() ? variables.currentLocale : 'en' )#" dir="#encodeForHTML( variables.currentLocaleDir )#">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>#encodeForHTML( variables.page.title )# - #encodeForHTML( variables.siteConfig.name )#</title>
	<meta property="og:type" content="#encodeForHTML( len( trim( variables.page.ogType ?: '' ) ) ? variables.page.ogType : 'website' )#">
	<meta property="og:site_name" content="#encodeForHTML( variables.siteConfig.name )#">
	<meta property="og:title" content="#encodeForHTML( variables.page.title )#">

	<!--- Open Graph and meta tags for SEO --->
	#renderArticleMeta()#

	<!--- Canonical URL --->
	<bx:if len( variables.page.canonicalUrl )>
		<link rel="canonical" href="#encodeForHTML( variables.page.canonicalUrl )#">
	</bx:if>

	<!--- Meta description and Open Graph description --->
	<bx:if len( variables.ogDescription )>
		<meta name="description" content="#encodeForHTML( variables.ogDescription )#">
		<meta property="og:description" content="#encodeForHTML( variables.ogDescription )#">
	</bx:if>

	<!--- Open Graph image and Twitter card --->
	<bx:if len( variables.ogImageUrl )>
		<meta property="og:image" content="#resolveAssetUrl( variables.ogImageUrl )#">
		<meta name="twitter:card" content="summary_large_image">
	</bx:if>

	<!--- Favicon --->
	<bx:if len( variables.faviconUrl )>
		<link rel="icon" href="#resolveAssetUrl( variables.faviconUrl )#">
		<link rel="apple-touch-icon" href="#variables.basePath#assets/brand/apple-touch-icon.png">
	</bx:if>

	<!--- Color mode detection (before CSS, to avoid flash) --->
	<script>
		( function () {
			var configuredMode = "#variables.siteConfig.theme.options.colorMode ?: 'auto'#";
			var stored = localStorage.getItem( "bxsites-theme" );
			var prefersDark = window.matchMedia( "(prefers-color-scheme: dark)" ).matches;
			var wantsDark = stored ? stored === "dark" : ( configuredMode === "dark" || ( configuredMode === "auto" && prefersDark ) );
			if ( wantsDark ) {
				document.documentElement.setAttribute( "data-theme", "dark" );
			}
		} )();
	</script>

	<!--- Base CSS and theme CSS (+ the homepage-only stylesheet) --->
	<link rel="stylesheet" href="#variables.basePath#assets/vendor/bootstrap/bootstrap.min.css">
	<link rel="stylesheet" href="#variables.basePath#assets/vendor/highlight/github.min.css">
	<link rel="stylesheet" href="#themeAssetUrl( 'style.css' )#">
	<link rel="stylesheet" href="#moduleAssetUrl( 'home.css' )#">
	<style>
		.pw-code{margin:0;padding:18px 20px;font:13.5px/1.65 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;color:inherit;white-space:pre;overflow-x:auto;background:transparent}
		.pw-code .k{color:##00c853}.pw-code .s{color:##0ea5e9}.pw-code .c{opacity:.55}
		[data-theme=dark] .pw-code .k{color:##34d399}[data-theme=dark] .pw-code .s{color:##7dd3fc}
		.eco-card .icon img{width:100%;height:100%;object-fit:contain;display:block}
		.pw-dist{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}
		.bxh-brand img.brand-wordmark{width:auto;height:48px;display:block;margin-block:-6px}
		.footer-brand .bxh-brand img.brand-wordmark{height:56px;margin:0 0 4px -4px}
		.brand-wordmark-dark{display:none!important}
		[data-theme=dark] .brand-wordmark-light{display:none!important}
		[data-theme=dark] .brand-wordmark-dark{display:block!important}
		.bxh-hero-grid{align-items:center}
		.hero-mark{display:block;width:120px;height:auto;margin:0 0 6px -10px;filter:drop-shadow(0 12px 30px rgba(0,219,255,.35)) drop-shadow(0 4px 14px rgba(0,255,117,.25));animation:pw-float 6s ease-in-out infinite}
		@keyframes pw-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
		@media (prefers-reduced-motion:reduce){.hero-mark{animation:none}}
		@media (max-width:640px){.hero-mark{width:88px;margin-bottom:16px}.bxh-brand img.brand-wordmark{height:38px}}
		.section-link{display:inline-flex;align-items:center;gap:6px;margin-top:14px;font-weight:600;color:var(--brand1)}
		.section-link:hover{text-decoration:underline}
		.pw-gallery{display:grid;margin-top:28px;grid-template-columns:repeat(var(--bxsites-gallery-cols,3),minmax(0,1fr));gap:22px}
		.pw-gallery .bxsites-image-gallery__item{margin:0;min-width:0}
		.pw-gallery .bxsites-image-gallery__image{display:block;width:100%;height:auto;object-fit:cover;transition:transform .2s ease,box-shadow .2s ease}
		.pw-gallery .bxsites-image-gallery__image:hover{transform:translateY(-3px);box-shadow:0 20px 44px var(--shadow-color-soft)}
		@media (max-width:900px){.pw-gallery{--bxsites-gallery-cols:2}}
		@media (max-width:560px){.pw-gallery{--bxsites-gallery-cols:1}}
		.pw-gallery .bxsites-image-gallery__image{aspect-ratio:16/10;object-position:top center}
		.pw-gallery .bxsites-image-gallery__image{border-radius:12px;border:1px solid var(--border-strong);box-shadow:0 14px 34px var(--shadow-color-soft);cursor:zoom-in}
		.pw-gallery .bxsites-image-gallery__caption{text-align:left;font-size:.92rem;color:var(--muted);margin-top:10px}
		.pw-gallery .bxsites-image-gallery__caption b{display:block;color:var(--text);margin-bottom:2px}
		.pw-split{display:grid;grid-template-columns:1.05fr 1fr;gap:44px;align-items:center}
		.pw-split>*{min-width:0}
		@media (max-width:900px){.pw-split{grid-template-columns:1fr;gap:28px}}
		.pw-checks{list-style:none;padding:0;margin:20px 0 0;display:grid;gap:12px}
		.pw-checks li{display:flex;gap:12px;align-items:flex-start;color:var(--muted)}
		.pw-checks li svg{flex:none;width:20px;height:20px;margin-top:2px;color:var(--brand1)}
		.pw-checks li b{color:var(--text)}
		.pw-tb-logos{display:flex;align-items:center;gap:14px;margin-bottom:14px;color:var(--muted);font-size:1.4rem}
		.pw-tb-logos .icon{width:44px;height:44px;display:grid;place-items:center;border-radius:12px;background:var(--surface);border:1px solid var(--border-strong)}
		.pw-tb-logos .icon svg,.pw-tb-logos .icon img{width:28px;height:28px}
		.pw-term{margin:0;max-width:none}
		.pw-term .term-body{min-height:0;line-height:1.75;font-size:.82rem;white-space:pre-wrap;overflow-wrap:anywhere}
		.pw-term .tl{padding-left:2ch;text-indent:-2ch}
		.pw-term .tl{display:block;color:var(--muted)}
		.pw-term .tl .ok{color:var(--brand1);font-weight:700}
		.pw-term .tl .cmd{color:var(--text)}
		.pw-term .tl .pr{color:var(--brand2)}
		.pw-term .tl .cm{opacity:.7}
		@media (prefers-reduced-motion:no-preference){.pw-term .tl{opacity:0;animation:pw-line .35s ease forwards}}
		@keyframes pw-line{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
		.pw-verbs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:22px}
		@media (max-width:640px){.pw-verbs{grid-template-columns:1fr}}
		.pw-verb{padding:14px 16px;border:1px solid var(--border-strong);border-radius:12px;background:var(--surface)}
		.pw-verb h4{margin:0 0 4px;font-size:.95rem}
		.pw-verb p{margin:0;font-size:.88rem;color:var(--muted)}
		.pw-verb code{font-size:.82rem}
		.pw-partner{display:block;height:40px;width:auto;margin:0 auto 18px}
		.pw-logo-dark{display:none!important}
		[data-theme=dark] .pw-logo-light{display:none!important}
		[data-theme=dark] .pw-logo-dark{display:block!important}
		.madeby a,.builtwith a{display:inline-flex;align-items:center}
		.madeby img{height:22px;width:auto;margin-left:6px}
		.builtwith{display:inline-flex;align-items:center;gap:8px;font-size:.85rem;color:var(--muted)}
		.builtwith img{height:24px;width:auto}
		.footlinks{flex-wrap:wrap;row-gap:8px;max-width:100%}
		.pw-demo{max-width:960px;margin:0 auto}
		.pw-demo img{display:block;width:100%;height:auto}
	</style>

	<!--- Extra CSS --->
	#renderExtraCss( variables.siteConfig.extraCss ?: [] )#

	<!--- Accent color overrides --->
	<bx:if len( variables.accentColor ) or len( variables.accentColorDark )>
		<style>
			<!--- Light mode accent color --->
			<bx:if len( variables.accentColor )>
				:root {
					--bxsites-accent: #variables.accentColor#;
					--bxsites-link: #variables.accentColor#;
					--bxsites-link-hover: color-mix( in srgb, #variables.accentColor# 85%, black );
				}
			</bx:if>
			<!--- Dark mode accent color --->
			<bx:if len( variables.accentColorDark )>
				[data-theme="dark"] {
					--bxsites-accent: #variables.accentColorDark#;
					--bxsites-link: #variables.accentColorDark#;
					--bxsites-link-hover: color-mix( in srgb, #variables.accentColorDark# 85%, white );
				}
			</bx:if>
		</style>
	</bx:if>

	<!--- Math CSS --->
	<bx:if variables.mathEnabled>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css">
	</bx:if>

	<!--- OpenAPI CSS --->
	<bx:if variables.openapiEnabled>
		<link rel="stylesheet" href="#variables.basePath#assets/vendor/swagger-ui/swagger-ui.css">
	</bx:if>

	<!--- Google Analytics --->
	<bx:if variables.analyticsProvider == 'google'>
		<script async src="https://www.googletagmanager.com/gtag/js?id=#encodeForHTML( variables.analyticsId )#"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', '#variables.analyticsId#');
		</script>
	</bx:if>

	<!--- Local search CSS and JS --->
	<bx:if variables.searchEnabled and variables.searchProviderName eq 'local'>
		<script>window.__BXSITES_BASE_PATH__ = "#variables.basePath#";</script>
		<script>window.__BXSITES_SEARCH_NO_RESULTS__ = "#encodeForJavaScript( variables.strings.searchNoResults )#";</script>
		<script src="#variables.basePath#assets/vendor/minisearch/minisearch.js"></script>
		<script src="#moduleAssetUrl( 'search.js' )#" defer></script>
	</bx:if>

	<!--- Algolia search CSS --->
	<bx:if variables.searchEnabled and variables.searchProviderName eq 'algolia'>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@docsearch/css@3">
	</bx:if>

	<!--- Pagefind search CSS --->
	<bx:if variables.searchEnabled and variables.searchProviderName eq 'pagefind'>
		<link rel="stylesheet" href="#variables.basePath#pagefind/pagefind-ui.css">
	</bx:if>

	<!--- Alpine JS --->
	<script src="#variables.basePath#assets/vendor/alpine/cdn.min.js" defer></script>
</head>
<body
	class="bxsites-home"
	x-data="{ dark: document.documentElement.getAttribute( 'data-theme' ) === 'dark' }"
	x-init="$watch( 'dark', v => { document.documentElement.setAttribute( 'data-theme', v ? 'dark' : 'light' ); localStorage.setItem( 'bxsites-theme', v ? 'dark' : 'light' ) } )">

	<!--- SVG gradient defs used by the brand mark / ecosystem icons --->
	<svg width="0" height="0" style="position:absolute" aria-hidden="true">
		<defs>
			<linearGradient id="bxlMarkGrad" x1="15.624" y1="250" x2="484.376" y2="250" gradientUnits="userSpaceOnUse">
				<stop stop-color="##00DBFF"/><stop offset="1" stop-color="##00FF75"/>
			</linearGradient>
		</defs>
	</svg>


	<!--- Header: horizontal marketing nav --->
	<header class="bxh-nav">
		<div class="bxh-wrap bxh-navrow">
			<a class="bxh-brand" href="#variables.basePath#">#renderWordmark()#</a>
			<nav class="bxh-navlinks">
				<a href="#variables.basePath#getting-started/">Docs</a>
				<a href="#variables.basePath#testing/">Testing</a>
				<a href="#variables.basePath#ai/">AI Agents</a>
				<a href="#variables.basePath#cli/">CLI</a>
			</nav>
			<div class="bxh-navcta">
				<div class="bxh-search">
					<bx:if variables.searchEnabled>
						<bx:include template="#variables.themeDir#/search.bxm">
					</bx:if>
				</div>
				<div class="bxh-nav-utils">
					<bx:if variables.versions.len() gt 1>
						#renderVersionSwitcher( variables.versions, variables.currentVersion )#
					</bx:if>
					<bx:if variables.locales.len() gt 1>
						#renderLocaleDropdown( variables.locales, variables.currentLocale )#
					</bx:if>
					<button type="button" class="bxh-theme-toggle" @click="dark = !dark" aria-label="#encodeForHTML( variables.strings.toggleDarkMode )#">
						<span x-show="!dark">#bxsitesIcon( "moon" )#</span>
						<span x-show="dark" x-cloak>#bxsitesIcon( "sun" )#</span>
					</button>
				</div>
				<bx:if len( variables.repoUrl )>
					<a class="bxh-btn bxh-btn-ghost bxh-btn-sm" href="#bxsitesUrlAttr( variables.repoUrl )#" target="_blank" rel="noopener noreferrer">#bxsitesIcon( "github" )# Star</a>
				</bx:if>
			</div>
		</div>
	</header>

	<!--- Hero: eyebrow, headline, lead, CTAs, install chip, code preview --->
	<main class="bxh-wrap bxh-hero">
		<div class="bxh-hero-grid">
			<div>
				<img class="hero-mark" src="#variables.basePath#assets/brand/bxplaywright-icon.svg" alt="" width="120" height="120">
				<span class="eyebrow">BoxLang module &middot; powered by Microsoft Playwright</span>
				<h1>Real browsers.<br><span class="grad">Fluent BoxLang.</span></h1>
				<p class="lead">
					<strong>bx-playwright</strong> drives Chromium, Firefox and WebKit from BoxLang. Test your apps end to end, mock the network, test APIs, render HTML to PDFs and images, and give AI agents a browser. One fluent API, no Node.js project to maintain.
				</p>
				<div class="hero-actions">
					<a class="bxh-btn bxh-btn-primary" href="#variables.basePath#getting-started/">Get Started &rarr;</a>
					<bx:if len( variables.repoUrl )>
						<a class="bxh-btn bxh-btn-ghost" href="#bxsitesUrlAttr( variables.repoUrl )#" target="_blank" rel="noopener noreferrer">#bxsitesIcon( "github" )# Star on GitHub</a>
					</bx:if>
				</div>
				<div class="install-chip">
					<span>$</span><span>install-bx-module bx-playwright</span><span class="sep">|</span><span>bxPlaywright install</span>
				</div>
			</div>
			<div class="preview">
				<div class="float-badge badge-1">#homeIcon( "check-shield" )# login flow passed &middot; 1.2s</div>
				<div class="preview-card">
					<div class="preview-bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="url">login.bxs</span></div>
<pre class="pw-code"><span class="k">playwright</span>().browse( ( page ) =&gt; {
    page.visit( <span class="s">"/login"</span> )
        .fill( <span class="s">"Email"</span>, <span class="s">"luis@ortus.com"</span> )
        .fill( <span class="s">"Password"</span>, <span class="s">"secret"</span> )
        .click( <span class="s">"Sign in"</span> )
        .assertPathIs( <span class="s">"/dashboard"</span> )
        .assertSee( <span class="s">"Welcome back"</span> )
        .screenshot( <span class="s">"dashboard.png"</span> )
} )</pre>
				</div>
				<div class="float-badge badge-2">#bxsitesIcon( "globe" )# Chromium &middot; Firefox &middot; WebKit</div>
			</div>
		</div>
	</main>

	<!--- Section: the flow (install, browse, assert, ship) --->
	<section>
		<div class="bxh-wrap bxh-orbit-wrap">
			<div class="section-head" style="text-align:center;margin-inline:auto">
				<span class="eyebrow" style="justify-content:center">How it works</span>
				<h2>Write it like a user. Run it like a browser.</h2>
			</div>
			<div class="flow-row">
				<div class="flow-stage"><div class="flow-icon">#homeIcon( "cube" )#</div><span>Install</span></div>
				<div class="flow-connector"><div class="line"></div><span class="flow-pulse" style="animation-delay:0s"></span></div>
				<div class="flow-stage"><div class="flow-icon">#bxsitesIcon( "globe" )#</div><span>Browse</span></div>
				<div class="flow-connector"><div class="line"></div><span class="flow-pulse" style="animation-delay:.7s"></span></div>
				<div class="flow-stage"><div class="flow-icon">#homeIcon( "check-shield" )#</div><span>Assert</span></div>
				<div class="flow-connector"><div class="line"></div><span class="flow-pulse" style="animation-delay:1.4s"></span></div>
				<div class="flow-stage"><div class="flow-icon">#homeIcon( "deploy" )#</div><span>Ship</span></div>
			</div>
			<p class="orbit-caption">Selectors read like the page: <code>fill( "Email" )</code>, <code>click( "Sign in" )</code>. Assertions wait for the page, so tests do not need sleeps. When something fails you get a typed error that says how to fix it, plus the screenshot, trace and video.</p>
			<p style="text-align:center;margin:0"><a class="section-link" href="#variables.basePath#getting-started/">Getting started &rarr;</a></p>
		</div>
	</section>

	<!--- Section: see it in action (real captures from a TestBox browser spec run) --->
	<section>
		<div class="bxh-wrap">
			<div class="section-head" style="text-align:center;margin-inline:auto">
				<span class="eyebrow" style="justify-content:center">See it in action</span>
				<h2>When a test fails, you see exactly why.</h2>
				<p>A real run: a TestBox browser spec signs in, checks the dashboard, and fails on purpose. The <code>ci</code> profile keeps the screenshot, the trace and the video, and TestBox attaches them to the failing spec.</p>
			</div>
			<div class="preview-card pw-demo">
				<div class="preview-bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="url">tests/browser/ShopSpec.bx</span></div>
				<img src="#variables.basePath#assets/demo-browser-test.gif" alt="A browser test signing in to a demo shop and checking the dashboard" loading="lazy" width="960" height="540">
			</div>
			<div class="bxsites-image-gallery bxsites-image-gallery--cols-3 pw-gallery">
				<figure class="bxsites-image-gallery__item">
					<img class="bxsites-image-gallery__image" src="#variables.basePath#assets/demo-failure-screenshot.png" alt="Failure screenshot of the dashboard with the last order still Processing" data-bxsites-lightbox loading="lazy">
					<figcaption class="bxsites-image-gallery__caption"><b>The screenshot</b>The page at the moment the assertion gave up: the last order still says Processing.</figcaption>
				</figure>
				<figure class="bxsites-image-gallery__item">
					<img class="bxsites-image-gallery__image" src="#variables.basePath#assets/demo-trace-viewer.png" alt="The Playwright trace viewer showing the failed hasText assertion" data-bxsites-lightbox loading="lazy">
					<figcaption class="bxsites-image-gallery__caption"><b>The trace</b><code>bxPlaywright show-trace</code> replays every action with the DOM, console and network.</figcaption>
				</figure>
				<figure class="bxsites-image-gallery__item">
					<img class="bxsites-image-gallery__image" style="object-position:left top" src="#variables.basePath#assets/demo-testbox-attachments.png" alt="A failing TestBox spec with its screenshot, trace and video attached" data-bxsites-lightbox loading="lazy">
					<figcaption class="bxsites-image-gallery__caption"><b>The report</b>TestBox links the screenshot, trace and video right under the failing spec.</figcaption>
				</figure>
			</div>
			<div class="hero-actions" style="justify-content:center;margin-top:28px">
				<a class="bxh-btn bxh-btn-primary" href="#variables.basePath#testing/">Browser testing guide &rarr;</a>
				<a class="bxh-btn bxh-btn-ghost" href="#variables.basePath#testing/">Artifacts and the trace viewer</a>
			</div>
		</div>
	</section>

	<!--- Section: TestBox integration --->
	<section class="comparison-section">
		<div class="bxh-wrap">
			<div class="pw-split">
				<div>
					<div class="pw-tb-logos"><span class="icon">#homeIcon( "testbox" )#</span>+<span class="icon"><img src="#variables.basePath#assets/brand/bxplaywright-icon.svg" alt=""></span></div>
					<span class="eyebrow">TestBox integration</span>
					<h2>Browser tests are just TestBox specs.</h2>
					<p class="lead" style="font-size:1.05rem">Add <code>@browser</code> to any spec, call <code>browse()</code> and write <code>describe()</code>, <code>it()</code> and <code>expect()</code> like any other spec. TestBox 7.2 brings the rest.</p>
					<ul class="pw-checks">
						<li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="10" r="8.2" stroke-width="1.6" opacity=".35"/><path d="M6.4 10.3l2.4 2.4 4.8-5.2"/></svg><span><b>One browser per bundle, fresh pages per spec.</b> Set it up with <code>@browserProfile( "ci" )</code> and <code>@baseURL</code>, closed for you after the bundle, even when <code>afterAll()</code> throws.</span></li>
						<li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="10" r="8.2" stroke-width="1.6" opacity=".35"/><path d="M6.4 10.3l2.4 2.4 4.8-5.2"/></svg><span><b>Browser matchers.</b> <code>toSee()</code>, <code>toHaveTitle()</code>, <code>toHavePath()</code>, <code>toHaveText()</code>, <code>toBeVisible()</code> and more, retrying like Playwright's own assertions.</span></li>
						<li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="10" r="8.2" stroke-width="1.6" opacity=".35"/><path d="M6.4 10.3l2.4 2.4 4.8-5.2"/></svg><span><b>Evidence on every failure.</b> Screenshots, traces and videos attached to the spec, with screenshots shown inline in the HTML reports.</span></li>
						<li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="10" r="8.2" stroke-width="1.6" opacity=".35"/><path d="M6.4 10.3l2.4 2.4 4.8-5.2"/></svg><span><b>Retries and Run Failed.</b> Retry flaky specs, then rerun only what failed with <code>--failed</code> or the Run Failed button.</span></li>
						<li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="10" r="8.2" stroke-width="1.6" opacity=".35"/><path d="M6.4 10.3l2.4 2.4 4.8-5.2"/></svg><span><b>Your server, started for you.</b> <code>--web-server</code> starts the app before the tests and stops it after.</span></li>
					</ul>
					<div class="hero-actions" style="margin-top:22px">
						<a class="bxh-btn bxh-btn-primary" href="https://testbox.ortusbooks.com/browser-testing" target="_blank" rel="noopener noreferrer">TestBox browser testing guide &rarr;</a>
						<a class="bxh-btn bxh-btn-ghost" href="#variables.basePath#testbox/">Deploy it with TestBox</a>
					</div>
				</div>
				<div class="preview-card">
					<div class="preview-bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="url">tests/specs/ShopSpec.bx</span></div>
<pre class="pw-code"><span class="c">@browser</span>
<span class="c">@browserProfile( "ci" )</span>
<span class="c">@baseURL( "http://localhost:8080" )</span>
<span class="k">class</span> extends=<span class="s">"testbox.system.BaseSpec"</span> {

    <span class="k">function</span> run() {
        describe( <span class="s">"Shop"</span>, () =&gt; {
            it( <span class="s">"signs in"</span>, () =&gt; {
                browse( ( page ) =&gt; {
                    page.visit( <span class="s">"/"</span> )
                        .fill( <span class="s">"Email"</span>, <span class="s">"luis@ortus.com"</span> )
                        .click( <span class="s">"Sign in"</span> )
                    expect( page ).toHavePath( <span class="s">"/dashboard"</span> )
                    expect( page ).toSee( <span class="s">"Welcome, Luis"</span> )
                } )
            } )
        } )
    }

}</pre>
				</div>
			</div>
			<div class="bxsites-image-gallery bxsites-image-gallery--cols-3 pw-gallery" style="margin-top:44px">
				<figure class="bxsites-image-gallery__item">
					<img class="bxsites-image-gallery__image" src="#variables.basePath#assets/testbox/report-inline-screenshot.png" alt="The Simple report with the failure screenshot inline on the failed spec" data-bxsites-lightbox loading="lazy">
					<figcaption class="bxsites-image-gallery__caption"><b>Screenshots in the report</b>The failure screenshot shows right on the failed spec, embedded so it works anywhere.</figcaption>
				</figure>
				<figure class="bxsites-image-gallery__item">
					<img class="bxsites-image-gallery__image" src="#variables.basePath#assets/testbox/report-screenshot-zoom.png" alt="The failure screenshot open full size over the TestBox report" data-bxsites-lightbox loading="lazy">
					<figcaption class="bxsites-image-gallery__caption"><b>Full size in one click</b>Open any screenshot full size without leaving the report.</figcaption>
				</figure>
				<figure class="bxsites-image-gallery__item">
					<img class="bxsites-image-gallery__image" src="#variables.basePath#assets/testbox/report-dot-drawer.png" alt="The Dot reporter drawer with the failure, the screenshot and the trace" data-bxsites-lightbox loading="lazy">
					<figcaption class="bxsites-image-gallery__caption"><b>Every reporter</b>Simple, Dot, Doc and Min all show the evidence, with a Copy show-trace command button.</figcaption>
				</figure>
				<figure class="bxsites-image-gallery__item">
					<img class="bxsites-image-gallery__image" src="#variables.basePath#assets/testbox/report-doc.png" alt="The Doc reporter with the failed spec and its screenshot" data-bxsites-lightbox loading="lazy">
					<figcaption class="bxsites-image-gallery__caption"><b>Readable as a document</b>The Doc reporter keeps the screenshot next to the failure message.</figcaption>
				</figure>
				<figure class="bxsites-image-gallery__item">
					<img class="bxsites-image-gallery__image" src="#variables.basePath#assets/testbox/report-min-run-failed.png" alt="The Min reporter with Run All and Run Failed buttons" data-bxsites-lightbox loading="lazy">
					<figcaption class="bxsites-image-gallery__caption"><b>Run Failed</b>Rerun only the specs that failed, from the report or with <code>--failed</code>.</figcaption>
				</figure>
				<figure class="bxsites-image-gallery__item">
					<img class="bxsites-image-gallery__image" style="object-position:left top" src="#variables.basePath#assets/demo-testbox-attachments.png" alt="The Simple reporter listing the screenshot, trace and video of a failed spec" data-bxsites-lightbox loading="lazy">
					<figcaption class="bxsites-image-gallery__caption"><b>Attachments</b>The trace and the video sit under the spec, ready for the trace viewer.</figcaption>
				</figure>
			</div>
		</div>
	</section>

	<!--- Section: feature grid --->
	<section>
		<div class="bxh-wrap">
			<div class="section-head">
				<span class="eyebrow">Everything included</span>
				<h2>The whole Playwright, the BoxLang way.</h2>
				<p>Browser testing, automation and rendering in one module, with a CLI that installs everything it needs.</p>
				<a class="section-link" href="#variables.basePath#browsing/">Browse the docs &rarr;</a>
			</div>
			<div class="bxh-grid">
				<div class="bxh-card">
					<div class="icon">#homeIcon( "function" )#</div>
					<h3><a href="#variables.basePath#browsing/">A fluent DSL</a></h3>
					<p>The <code>playwright()</code> BIF, smart selectors (CSS, <code>@testId</code> or the text a user sees) and chainable actions. <code>browse()</code> cleans up for you.</p>
				</div>
				<div class="bxh-card">
					<div class="icon">#homeIcon( "check-shield" )#</div>
					<h3><a href="#variables.basePath#assertions/">Web-first assertions</a></h3>
					<p>Inline (<code>assertSee()</code>, <code>assertPathIs()</code>) or <code>expect()</code> style. Both retry until the page is ready, with soft assertions when you want every failure at once.</p>
				</div>
				<div class="bxh-card">
					<div class="icon">#homeIcon( "versions" )#</div>
					<h3><a href="#variables.basePath#profiles/">Profiles and devices</a></h3>
					<p><code>playwright( [ "mobile", "dark" ] )</code>. Built-in browsers, screens, devices and modes, plus your own in <code>boxlang.json</code> and <code>BX_PLAYWRIGHT_*</code> overrides.</p>
				</div>
				<div class="bxh-card">
					<div class="icon">#bxsitesIcon( "print" )#</div>
					<h3><a href="#variables.basePath#rendering/">PDFs and images</a></h3>
					<p><code>bx:playwrightRender</code> and <code>render()</code> turn HTML into PDF, PNG, JPEG or WebP with a real browser: modern CSS, web fonts and JavaScript included.</p>
				</div>
				<div class="bxh-card">
					<div class="icon">#homeIcon( "api" )#</div>
					<h3><a href="#variables.basePath#network/">Network and APIs</a></h3>
					<p>Mock, block and inspect requests with <code>intercept()</code>. Test HTTP APIs with <code>request()</code>. Save a login once and reuse it with <code>session()</code>.</p>
				</div>
				<div class="bxh-card">
					<div class="icon">#homeIcon( "themes" )#</div>
					<h3><a href="#variables.basePath#quality/">Visual regression</a></h3>
					<p><code>assertScreenshotMatches()</code> keeps baselines and writes a diff image with every changed pixel in red when the page drifts.</p>
				</div>
				<div class="bxh-card">
					<div class="icon">#homeIcon( "search" )#</div>
					<h3><a href="#variables.basePath#quality/">Quality checks</a></h3>
					<p>axe-core accessibility audits, console error checks and smoke tests, one method call each.</p>
				</div>
				<div class="bxh-card">
					<div class="icon">#homeIcon( "blocks" )#</div>
					<h3><a href="#variables.basePath#page-objects/">Page objects and macros</a></h3>
					<p>Keep tests readable with page objects, reusable page components and your own macros on every page.</p>
				</div>
				<div class="bxh-card">
					<div class="icon">#homeIcon( "list" )#</div>
					<h3><a href="#variables.basePath#testing/">Any test framework</a></h3>
					<p>Works in TestBox or any runner. Artifact policies keep screenshots, traces and videos of failed tests, and <code>show-trace</code> replays them.</p>
				</div>
				<div class="bxh-card">
					<div class="icon">#homeIcon( "server" )#</div>
					<h3><a href="#variables.basePath#cli/">The bxPlaywright CLI</a></h3>
					<p><code>install</code>, <code>doctor</code>, <code>codegen</code>, <code>screenshot</code>, <code>pdf</code>, <code>show-trace</code> and <code>mcp</code>, with bash completions and <code>--json</code> output.</p>
				</div>
				<div class="bxh-card">
					<div class="icon">#bxsitesIcon( "sparkle" )#</div>
					<h3><a href="#variables.basePath#cli/">Record BoxLang code</a></h3>
					<p><code>bxPlaywright codegen</code> opens a browser, records your clicks and writes bx-playwright code for you.</p>
				</div>
				<div class="bxh-card">
					<div class="icon">#homeIcon( "java" )#</div>
					<h3><a href="#variables.basePath#configuration/">Pure JVM, no Node project</a></h3>
					<p>Built on Playwright for Java. The driver is managed for you, and Node.js is found, downloaded or bundled: you never write a <code>package.json</code>.</p>
				</div>
			</div>
		</div>
	</section>

	<!--- Section: the bxPlaywright CLI --->
	<section>
		<div class="bxh-wrap">
			<div class="pw-split">
				<div>
					<span class="eyebrow">The bxPlaywright CLI</span>
					<h2>One command line for the whole browser toolchain.</h2>
					<p class="lead" style="font-size:1.05rem">Install browsers and their system libraries, check your setup, record tests, capture pages and serve a browser to your AI agent. No Node.js project, no <code>package.json</code>.</p>
					<div class="pw-verbs"><div class="pw-verb"><h4>Set up</h4><p><code>install</code>, <code>install-deps</code>, <code>doctor</code> and <code>version</code>: everything a browser needs, checked with fix hints.</p></div><div class="pw-verb"><h4>Record and replay</h4><p><code>codegen</code> writes BoxLang from your clicks, <code>open</code> drives a headed browser and <code>show-trace</code> replays a failure.</p></div><div class="pw-verb"><h4>Capture</h4><p><code>screenshot</code> and <code>pdf</code> grab any URL from the shell, no script needed.</p></div><div class="pw-verb"><h4>Agents and automation</h4><p><code>mcp</code> serves a browser to AI agents. Every verb speaks <code>--json</code>, with bash completions included.</p></div></div>
					<a class="section-link" href="#variables.basePath#cli/">CLI reference &rarr;</a>
				</div>
				<div class="term-panel pw-term">
					<div class="preview-bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="url">bash</span></div>
					<div class="term-body"><span class="tl" style="animation-delay:0.00s"><span class="pr">$</span> <span class="cmd">bxPlaywright install chromium --with-deps</span></span><span class="tl" style="animation-delay:0.25s"><span class="cm">  driver, Node.js and Chromium, plus the Linux system libraries</span></span><span class="tl" style="animation-delay:0.50s">&nbsp;</span><span class="tl" style="animation-delay:0.75s"><span class="pr">$</span> <span class="cmd">bxPlaywright doctor</span></span><span class="tl" style="animation-delay:1.00s"><span class="ok">[ok]</span>   module    bx-playwright (small), Playwright 1.63.0, Java 21</span><span class="tl" style="animation-delay:1.25s"><span class="ok">[ok]</span>   driver    Extracted at ~/.boxlang/playwright/driver/1.63.0</span><span class="tl" style="animation-delay:1.50s"><span class="ok">[ok]</span>   node      Node.js 24.21.0 (downloaded)</span><span class="tl" style="animation-delay:1.75s"><span class="ok">[ok]</span>   browsers  chromium-1243, chromium_headless_shell-1243</span><span class="tl" style="animation-delay:2.00s"><span class="ok">[ok]</span>   defaults  profile default, chromium, headless true</span><span class="tl" style="animation-delay:2.25s">&nbsp;</span><span class="tl" style="animation-delay:2.50s"><span class="pr">$</span> <span class="cmd">bxPlaywright codegen http://localhost:8080 -o login.bxs</span></span><span class="tl" style="animation-delay:2.75s"><span class="cm">  records your clicks and writes bx-playwright code</span></span><span class="tl" style="animation-delay:3.00s">&nbsp;</span><span class="tl" style="animation-delay:3.25s"><span class="pr">$</span> <span class="cmd">bxPlaywright mcp --headless</span></span><span class="tl" style="animation-delay:3.50s"><span class="cm">  a browser for Claude, Cursor, VS Code and any MCP client</span></span></div>
				</div>
			</div>
		</div>
	</section>

	<!--- Section: AI agents --->
	<section class="comparison-section">
		<div class="bxh-wrap">
			<div class="section-head">
				<span class="eyebrow">Built for AI agents</span>
				<h2>Let your agent see the app it builds.</h2>
				<p>An agent that writes code but never runs the app is guessing. With bx-playwright it builds a feature, uses it in a real browser, fixes what is broken, and leaves browser tests behind.</p>
				<a class="section-link" href="#variables.basePath#ai/">AI agents guide &rarr;</a>
				<div class="stack-strip">
					<span class="label">Works with</span>
					<span title="Claude">#homeIcon( "claude" )#</span>
					<span title="ChatGPT">#homeIcon( "chatgpt" )#</span>
					<span title="Gemini">#homeIcon( "gemini" )#</span>
					<span title="Cursor">#homeIcon( "cursor" )#</span>
					<span title="Any MCP agent">#homeIcon( "robot" )#</span>
				</div>
			</div>
			<div class="term-panel">
				<div class="preview-bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="url">page.snapshot( options = { mode : "ai" } )</span></div>
				<div class="term-body">
					<div class="term-line" style="animation-delay:0s">- heading "Sign in" [level=1] [ref=e2]</div>
					<div class="term-line" style="animation-delay:.9s">- textbox "Email" [ref=e5]</div>
					<div class="term-line" style="animation-delay:1.8s">- textbox "Password" [ref=e6]</div>
					<div class="term-line" style="animation-delay:2.7s">- button "Sign in" [ref=e7]<span class="term-cursor"></span></div>
				</div>
			</div>
			<div class="bxh-grid" style="margin-top:32px">
				<div class="bxh-card">
					<div class="icon">#homeIcon( "list" )#</div>
					<h3><a href="#variables.basePath#ai/">Snapshots with refs</a></h3>
					<p>A compact, token-efficient view of the page. Agents act on refs directly: <code>click( "ref=e7" )</code>.</p>
				</div>
				<div class="bxh-card">
					<div class="icon">#homeIcon( "robot" )#</div>
					<h3><a href="#variables.basePath#ai/">Browser tools for BoxLang AI</a></h3>
					<p><code>aiTools()</code> gives any bx-ai agent ten browser tools: visit, snapshot, click, fill, select and more.</p>
				</div>
				<div class="bxh-card">
					<div class="icon">#homeIcon( "server" )#</div>
					<h3><a href="#variables.basePath#ai/">Playwright MCP</a></h3>
					<p><code>bxPlaywright mcp</code> starts Playwright's MCP server for Claude, Cursor, VS Code and every MCP client.</p>
				</div>
				<div class="bxh-card">
					<div class="icon">#bxsitesIcon( "copy" )#</div>
					<h3><a href="#variables.basePath#errors/">An API that explains itself</a></h3>
					<p><code>help()</code> on every object, typed errors with the fix in <code>detail</code>, and these docs as <code>llms.txt</code>.</p>
				</div>
				<div class="bxh-card bxh-card-wide">
					<div class="icon">#homeIcon( "check-shield" )#</div>
					<div>
						<h3><a href="https://skills.boxlang.io/skills?search=playwright" target="_blank" rel="noopener noreferrer">Official Agent Skills</a></h3>
						<p><code>npx skills add ortus-boxlang/skills/boxlang-modules/bx-playwright</code> teaches Claude Code, Cursor and other coding agents how to set up, browse, assert, mock, render and test with bx-playwright. Browse all seven skills on <a href="https://skills.boxlang.io/skills?search=playwright" target="_blank" rel="noopener noreferrer">skills.boxlang.io</a>.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!--- Section: the two distributions --->
	<section>
		<div class="bxh-wrap">
			<div class="section-head">
				<span class="eyebrow">Two distributions</span>
				<h2>Small and nimble, or everything in the box.</h2>
				<p>Same module, same API. Pick the one that fits how you deploy.</p>
				<a class="section-link" href="#variables.basePath#getting-started/">Installation guide &rarr;</a>
			</div>
			<div class="pw-dist">
				<div class="bxh-card">
					<div class="icon">#homeIcon( "cube" )#</div>
					<h3><a href="#variables.basePath#getting-started/">bx-playwright</a></h3>
					<p>About 4 MB. Uses a Node.js 20+ already on the machine, or <code>bxPlaywright install</code> downloads and verifies one for your platform.</p>
				</div>
				<div class="bxh-card">
					<div class="icon">#homeIcon( "offline" )#</div>
					<h3><a href="#variables.basePath#getting-started/">bx-playwright-full</a></h3>
					<p>Bundles Node.js for every platform. Nothing else to download except the browsers: ideal for locked-down and air-gapped servers.</p>
				</div>
			</div>
			<div class="install-chip" style="margin-top:24px">
				<span>$</span><span>install-bx-module bx-playwright</span><span class="sep">|</span><span>install-bx-module bx-playwright-full</span>
			</div>
		</div>
	</section>

	<!--- Section: BoxLang ecosystem --->
	<section>
		<div class="bxh-wrap">
			<div class="section-head" style="text-align:center;margin-inline:auto">
				<span class="eyebrow" style="justify-content:center">Part of the BoxLang ecosystem</span>
				<h2>Not a one&##8209;off tool. A whole platform.</h2>
				<div class="eco-hero-mark">#homeIcon( "boxlang" )#</div>
			</div>
			<div class="eco-row">
				<a class="eco-card" href="https://boxlang.io" target="_blank" rel="noopener noreferrer">
					<div class="icon">#homeIcon( "boxlang" )#</div><b>BoxLang</b><span>The dynamic JVM language bx-playwright is built for.</span>
				</a>
				<a class="eco-card" href="https://ai.boxlang.io" target="_blank" rel="noopener noreferrer">
					<div class="icon">#homeIcon( "robot" )#</div><b>BoxLang AI</b><span>Agents, tools and RAG. Give them a browser with <code>aiTools()</code>.</span>
				</a>
