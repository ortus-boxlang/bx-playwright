/**
 * Test page component for the cart widget
 */
class extends="models.PageComponent@playwright" {

	selector = "@cart"
	elements = { remove : "button" }

	/**
	 * Empty the cart by clicking its remove button.
	 *
	 * @return The component, for chaining
	 */
	function empty() {
		return click( "@remove" )
	}

}
