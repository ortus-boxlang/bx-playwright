#compdef bxplaywright
# bxplaywright zsh completions. Generated by `bxplaywright completions zsh`, do not edit.
# Load: source <(bxplaywright completions zsh), or save it as _bxplaywright in a folder of $fpath.
_bxplaywright() {
	local -a verbs
	verbs=(
		'clean:Remove the extracted driver and downloaded Node.js (browsers are kept)'
		'codegen:Record browser actions and generate BoxLang code (or --target=java, javascript, python)'
		'completions:Print the tab completion script for bash (default), zsh, fish or powershell'
		'devices:List the device descriptors usable in the device setting'
		'doctor:Check versions, paths, Node.js and browsers, with fix hints'
		'help:Show help for all verbs or one verb'
		'install:Set up the driver and Node.js, then install browsers (default: chromium)'
		'install-deps:Install the operating system packages browsers need (Linux)'
		'install-node:Download the Node.js runtime only (small distribution)'
		'mcp:Start the Playwright MCP server for AI agents'
		'open:Open a headed browser'
		'pdf:Save a URL as PDF (Chromium)'
		'profiles:List profiles, or show one fully resolved'
		'run:Run any Playwright CLI command as-is'
		'screenshot:Take a screenshot of a URL'
		'show-trace:Open the trace viewer'
		'uninstall:Remove installed browsers'
		'version:Show the module, Playwright and Node.js versions'
	)
	if (( CURRENT == 2 )); then
		_describe -t commands 'bxplaywright verb' verbs
		compadd -- --help --version
		return
	fi
	case "${words[2]}" in
		clean) compadd -- --json ;;
		codegen) compadd -- --output --target --device --viewport-size --load-storage --save-storage ;;
		completions) compadd -- bash zsh fish powershell ;;
		devices) compadd -- --json ;;
		doctor) compadd -- --json ;;
		help) compadd -- --json clean codegen completions devices doctor help install install-deps install-node mcp open pdf profiles run screenshot show-trace uninstall version ;;
		install) compadd -- --with-deps --only-shell --force --skip-node --json chromium firefox webkit chrome chrome-beta msedge all ;;
		install-deps) compadd -- chromium firefox webkit chrome chrome-beta msedge all ;;
		install-node) compadd -- --force --json ;;
		mcp) compadd -- --headless --browser --port ;;
		open) compadd -- --device --browser ;;
		pdf) compadd -- --paper-format; _files ;;
		profiles) compadd -- --json 4k android android-tablet chrome chrome-beta chromium ci dark debug default desktop edge firefox galaxy hd headed high-contrast ipad iphone iphone-se laptop light macbook mobile mobile-landscape offline pixel print record reduced-motion screenshot tablet webkit ;;
		run) : ;;
		screenshot) compadd -- --full-page --device --browser; _files ;;
		show-trace) _files ;;
		uninstall) compadd -- --all ;;
		version) compadd -- --json ;;
	esac
}
if [[ "${funcstack[1]}" == "_bxplaywright" ]]; then
	_bxplaywright "$@"
else
	compdef _bxplaywright bxplaywright
fi
