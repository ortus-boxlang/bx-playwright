import java:ortus.boxlang.modules.playwright.engine.NodeInstaller@playwright;

/**
 * Installs Playwright browsers using this module's configured home and runtime.
 */
class {
	static {
		ensuredBrowsers = {}
	}

	/**
	 * Install browsers through the bundled Playwright CLI.
	 *
	 * @options CLI options, including _positionals (browser names)
	 * @config  The module configuration
	 *
	 * @return { exitCode, message, output, data }: output is the last lines the Playwright CLI printed
	 */
	struct function install( required struct options, required any config ) {
		var home     = arguments.config.home()
		var data     = { "driver" : "", "node" : {}, "browsers" : [] }
		var terminal = new models.cli.Terminal@playwright( arguments.options.json ?: false )
		var result   = {}

		lock name="bx-playwright-install-#hash( home.getBrowsersPath().toString() )#" type="exclusive" timeout="600" {
			if ( ( arguments.options.force ?: false ) || !home.isDriverInstalled() ) {
				terminal.progress( "Extracting the Playwright #home.getPlaywrightVersion()# driver into #home.getDriverDir()#" )
			} else {
				terminal.progress( "Using the extracted Playwright #home.getPlaywrightVersion()# driver at #home.getDriverDir()#" )
			}
			data.driver = home.installDriver( arguments.options.force ?: false ).toString()

			if ( !( arguments.options[ "skip-node" ] ?: false ) ) {
				terminal.progress( "Checking the Node.js runtime for Playwright..." )
				var node = terminal.node( home, arguments.config.nodePath() )
				if ( !node.found ) {
					new NodeInstaller(
						home,
						arguments.config.getSettings().nodeDownloadURL ?: "",
						( message ) => terminal.progress( message )
					).install( false )
					node = terminal.node( home, arguments.config.nodePath() )
				}
				if ( !node.ok ) {
					throw( type = "Playwright.NotInstalled", message = "#node.problem#.", detail = node.fix )
				}
				data.node = { "executable" : node.executable, "source" : node.source, "version" : node.version }
				terminal.progress( "Using Node.js #data.node.version# (#data.node.source#) at #data.node.executable#" )
			}

			var positionals = arguments.options._positionals ?: []
			var browsers    = positionals.len() ? positionals : [ "chromium" ]
			if ( browsers.findNoCase( "all" ) ) {
				browsers = []
			}
			var cliArgs = [ "install" ]
			cliArgs.append( browsers, true )
			if ( arguments.options[ "with-deps" ] ?: false ) {
				cliArgs.append( "--with-deps" )
			}
			if ( arguments.options[ "only-shell" ] ?: false ) {
				cliArgs.append( "--only-shell" )
			}
			if ( arguments.options.force ?: false ) {
				cliArgs.append( "--force" )
			}

			terminal.progress( "Checking required browser revisions with the Playwright CLI. The first install can take a few minutes." )
			var run      = terminal.installBrowsers( home, cliArgs )
			var exitCode = run.exitCode
			data.browsers = home.installedBrowsers()
			result = {
				exitCode : exitCode,
				message  : exitCode == 0 ? "Ready. Browsers in #home.getBrowsersPath()#: #data.browsers.toList( ", " )#" : "Browser installation failed (exit code #exitCode#). Run [bxPlaywright doctor].",
				output   : run.output,
				data     : data
			}
		}
		return result
	}

	/**
	 * Ensure one supported browser is installed for use by an application. A branded browser channel, like
	 * `chrome` or `msedge`, runs the browser installed on the machine, so nothing is downloaded for it.
	 *
	 * @browser The browser name: chromium, firefox or webkit
	 * @config  The module configuration
	 * @channel The browser channel, for example chrome or msedge, empty for the Playwright browser
	 *
	 * @return { browser, channel, path, installed }: installed lists the browser folders in the cache
	 *
	 * @throws Playwright.InvalidOption when the browser name is unsupported
	 * @throws Playwright.NotInstalled when installation fails, with the last lines of the Playwright CLI output in its detail
	 */
	struct function ensure( required string browser, required any config, string channel = "" ) {
		var browserName = arguments.browser.lCase().trim()
		if ( ![ "chromium", "firefox", "webkit" ].findNoCase( browserName ) ) {
			throw(
				type    = "Playwright.InvalidOption",
				message = "Unknown browser [#arguments.browser#].",
				detail  = "Use chromium, firefox or webkit."
			)
		}
		var home      = arguments.config.home()
		var channel   = arguments.channel.trim()
		if ( len( channel ) ) {
			return { "browser" : browserName, "channel" : channel, "path" : home.getBrowsersPath().toString(), "installed" : [] }
		}
		var cacheKey  = home.getHome().toString() & "|" & home.getPlaywrightVersion() & "|" & browserName
		var terminal  = new models.cli.Terminal@playwright()
		var result    = {}
		var cached    = false
		var installed = []

		lock name="bx-playwright-ensure-#hash( cacheKey )#" type="exclusive" timeout="600" {
			var previous        = static.ensuredBrowsers[ cacheKey ] ?: {}
			var previousFolders = previous.browserFolders ?: []
			var currentFolders  = home.installedBrowsers()
			cached = previousFolders.len() > 0
			for ( var folder in previousFolders ) {
				if ( !arrayFindNoCase( currentFolders, folder ) ) {
					cached = false
					break
				}
			}
			if ( cached ) {
				result = previous.result
			}

			if ( !cached ) {
				terminal.progress( "Ensuring the Playwright #browserName# browser is installed. The first setup may take a few minutes." )
				result = install( { _positionals : [ browserName ] }, arguments.config )
				if ( result.exitCode != 0 ) {
					throw(
						type    = "Playwright.NotInstalled",
						message = "Could not install #browserName# (exit code #result.exitCode#).",
						detail  = ( len( result.output ) ? "Playwright CLI output:#char( 10 )##result.output##char( 10 )##char( 10 )#" : "" )
						& "Check network access and server write permissions, or run [boxlang module:playwright install #browserName#] from this BoxLang server environment. Linux system libraries must be installed by the host or container."
					)
				}
				for ( var folder in result.data.browsers ) {
					if ( folder.startsWith( browserName & "-" ) ) {
						installed.append( folder )
					}
				}
				if ( installed.len() ) {
					static.ensuredBrowsers[ cacheKey ] = { result : result, browserFolders : installed }
				}
				terminal.progress( "Playwright #browserName# is ready at #home.getBrowsersPath()#." )
			} else {
				terminal.progress( "Playwright #browserName# is already installed at #home.getBrowsersPath()#; skipping setup." )
			}
		}
		return { "browser" : browserName, "channel" : "", "path" : home.getBrowsersPath().toString(), "installed" : result.data.browsers }
	}

}