import java:ortus.boxlang.modules.playwright.engine.PlaywrightErrors@playwright;

/**
 * A browser tab. Returned by playwright().visit(), newPage() and browse().
 *
 * <pre>
 * playwright().visit( "/login" )
 *     .fill( "Email", "luis@ortus.com" )
 *     .fill( "Password", "secret" )
 *     .click( "Sign in" )
 *     .assertPathIs( "/dashboard" )
 *     .assertSee( "Welcome" )
 *     .close()
 * </pre>
 *
 * Selector based actions, finders and assertions come from Scope.
 * Everything returns the page, so calls chain. getJava() returns the Playwright Page.
 */
class extends="Scope" {

	/**
	 * @java    The Playwright page
	 * @context The owning BrowserContext wrapper
	 */
	function init( required any java, required any context ) {
		variables.java        = arguments.java
		variables.context     = arguments.context
		variables.aliases     = {}
		variables.softErrors  = nullValue()
		return this
	}

	/**
	 * Which macros apply to this object.
	 *
	 * @return Always "page"
	 */
	string function macroTarget() {
		return "page"
	}

	/**
	 * The element aliases registered on this page.
	 *
	 * @return The element aliases usable as @name selectors
	 */
	struct function getAliases() {
		return variables.aliases
	}

	/**
	 * Register element aliases usable as @name selectors (page objects do this for you).
	 *
	 * @elements A struct of alias name to smart selector
	 */
	function useElements( required struct elements ) {
		variables.aliases.append( arguments.elements, true )
		return this
	}

	/**
	 * The collector of failed soft assertions while running inside soft().
	 *
	 * @return The soft assertion collector while inside soft(), otherwise null
	 */
	function softCollector() {
		return variables.softErrors ?: nullValue()
	}

	/**
	 * Soft assertions: run the callback, collect every failed assertion, then fail once with all of them.
	 * Nested soft() calls add their failures to the outer one, which fails once at the end.
	 *
	 * <pre>
	 * page.soft( ( page ) => {
	 *     page.assertSee( "Welcome" ).assertVisible( "@menu" ).assertTitle( "Home" )
	 * } )
	 * </pre>
	 *
	 * @callback Receives the page
	 */
	function soft( required function callback ) {
		var outer            = variables.softErrors ?: nullValue()
		variables.softErrors = []
		try {
			arguments.callback( this )
		} finally {
			var errors           = variables.softErrors
			variables.softErrors = outer ?: nullValue()
		}
		if ( !isNull( outer ) ) {
			// Inside another soft(): the outer one reports every failure at the end
			outer.append( errors, true )
			return this
		}
		if ( errors.len() ) {
			var numbered = []
			for ( var i = 1; i <= errors.len(); i++ ) {
				numbered.append( "#i#) #errors[ i ]#" )
			}
			throw(
				type    = "Playwright.AssertionFailed",
				message = "#errors.len()# soft assertion(s) failed: #numbered.toList( char( 10 ) )#",
				detail  = "Every assertion inside soft() ran; these are all the failures."
			)
		}
		return this
	}

	/**
	 * The underlying Playwright Page Java object.
	 *
	 * @return The Playwright Page, for anything not covered by the DSL
	 */
	function getJava() {
		return variables.java
	}

	/**
	 * The Playwright locator that scopes the page: the document itself (:scope), so locators built from it
	 * also work inside filter( { has, hasNot } ).
	 *
	 * @return A Playwright locator for :scope
	 */
	function root() {
		return variables.java.locator( ":scope" )
	}

	/**
	 * A page has no element to act on without a selector, so this always throws Playwright.InvalidOption.
	 */
	function self() {
		throw(
			type    = "Playwright.InvalidOption",
			message = "This page action needs a selector.",
			detail  = "Pass a smart selector: @testId, CSS (##id, .class) or visible text. Example: page.click( ""Save"" )"
		)
	}

	/**
	 * The owning Page wrapper, which is this page.
	 *
	 * @return This page
	 */
	function page() {
		return this
	}

	/**
	 * The resolved configuration of the owning playwright() call, taken from the browser context.
	 *
	 * @return The configuration struct
	 */
	function getConfig() {
		return variables.context.getConfig()
	}

	/**
	 * The locator used by page-wide reads and assertions: the document body.
	 *
	 * @return A Playwright locator for body
	 */
	function scopeLocator() {
		return variables.java.locator( "body" )
	}

	/**
	 * The target of expect() without a selector: the Playwright Page itself.
	 *
	 * @return The Playwright Page
	 */
	function expectTarget() {
		return variables.java
	}

	/**
	 * Take a screenshot of the page and return the PNG bytes.
	 *
	 * @options Playwright screenshot options (fullPage, clip, animations, mask, ...)
	 *
	 * @return The PNG bytes
	 */
	function captureScreenshot( struct options = {} ) {
		var opts = buildOptions( "Page.ScreenshotOptions", arguments.options )
		return tryAction( () => variables.java.screenshot( opts ), "screenshot()" )
	}

	/**
	 * The browser context this page belongs to.
	 *
	 * @return The BrowserContext wrapper that owns this page
	 */
	function context() {
		return variables.context
	}

	/**
	 * The playwright() manager that owns this page, through its browser context.
	 *
	 * @return The playwright() manager that owns this page
	 */
	function manager() {
		return variables.context.manager()
	}

	/**
	 * --------------------------------------------------------------------------
	 * Navigation
	 * --------------------------------------------------------------------------
	 */

	/**
	 * Go to a URL, or to a page object (its url is visited, it is bound to this page and its at() check runs).
	 * Relative URLs resolve against the baseURL setting.
	 *
	 * @url     Absolute URL, a path when baseURL is set, or a PageObject instance
	 * @options waitUntil (load, domcontentloaded, networkidle, commit), timeout, referer
	 *
	 * @return The page, or the bound page object
	 */
	function visit( required any url, struct options = {} ) {
		if ( isObject( arguments.url ) ) {
			var pageObject = arguments.url
			if ( !len( pageObject.getUrl() ) ) {
				throw(
					type    = "Playwright.InvalidOption",
					message = "The page object has no url.",
					detail  = "Set it in the page object pseudo-constructor, e.g. url = '/login', or use page.on( pageObject )."
				)
			}
			visit( pageObject.getUrl(), arguments.options )
			return on( pageObject )
		}
		var target = arguments.url
		var opts   = buildOptions( "Page.NavigateOptions", arguments.options )
		tryAction( () => variables.java.navigate( target, opts ), "visit( #target# )" )
		return this
	}

	/**
	 * Bind a page object to this page without navigating, and run its at() check.
	 *
	 * @pageObject A class extending models.PageObject@playwright
	 *
	 * @return The bound page object
	 */
	function on( required any pageObject ) {
		return arguments.pageObject.bind( this ).checkAt()
	}

	/**
	 * Go back in history.
	 */
	function back() {
		tryAction( () => variables.java.goBack(), "back()" )
		return this
	}

	/**
	 * Go forward in history.
	 */
	function forward() {
		tryAction( () => variables.java.goForward(), "forward()" )
		return this
	}

	/**
	 * Reload the page.
	 */
	function reload() {
		tryAction( () => variables.java.reload(), "reload()" )
		return this
	}

	/**
	 * Replace the page HTML (great for rendering and testing components).
	 *
	 * @html    The HTML
	 * @options waitUntil, timeout
	 */
	function setContent( required string html, struct options = {} ) {
		var markup = arguments.html
		var opts   = buildOptions( "Page.SetContentOptions", arguments.options )
		tryAction( () => variables.java.setContent( markup, opts ), "setContent()" )
		return this
	}

	/**
	 * The current URL of the page.
	 *
	 * @return The current URL
	 */
	string function url() {
		return variables.java.url()
	}

	/**
	 * The title of the page.
	 *
	 * @return The page title
	 */
	string function title() {
		return variables.java.title()
	}

	/**
	 * The rendered HTML of the page, including changes made by scripts.
	 *
	 * @return The full HTML of the page, after JavaScript ran
	 */
	string function content() {
		return variables.java.content()
	}

	/**
	 * --------------------------------------------------------------------------
	 * Waiting
	 * --------------------------------------------------------------------------
	 */

	/**
	 * Pause for a number of milliseconds. Prefer assertions and waitFor(), which wait only as needed.
	 *
	 * @milliseconds How long to wait
	 */
	function wait( required numeric milliseconds ) {
		variables.java.waitForTimeout( arguments.milliseconds )
		return this
	}

	/**
	 * Wait until the URL matches.
	 *
	 * @url     A full URL, a glob such as **\/dashboard, or a regex()
	 * @timeout Milliseconds, 0 for the navigation timeout
	 */
	function waitForUrl( required any url, numeric timeout = 0 ) {
		var target = arguments.url
		var opts   = buildOptions( "Page.WaitForURLOptions", arguments.timeout > 0 ? { timeout : arguments.timeout } : {} )
		tryAction( () => variables.java.waitForURL( target, opts ), "waitForUrl( #toString( target )# )" )
		return this
	}

	/**
	 * Wait for a load state.
	 *
	 * @state load (default), domcontentloaded or networkidle
	 */
	function waitForLoadState( string state = "load" ) {
		var loadState = enumValue( "LoadState", arguments.state )
		tryAction( () => variables.java.waitForLoadState( loadState ), "waitForLoadState( #arguments.state# )" )
		return this
	}

	/**
	 * Run a callback that opens a new tab or window, and return that new page.
	 *
	 * @callback Receives nothing; do the click that opens the popup
	 *
	 * @return The popup Page
	 */
	function waitForPopup( required function callback ) {
		var trigger = arguments.callback
		var popup   = tryAction( () => variables.java.waitForPopup( () => trigger() ), "waitForPopup()" )
		return variables.context.wrapPage( popup )
	}

	/**
	 * Run a callback that starts a download, and save it.
	 *
	 * @callback Receives nothing; do the click that starts the download
	 * @path     Where to save the file, or empty to keep it in a temporary folder
	 *
	 * @return { path, suggestedFilename, url }
	 */
	struct function waitForDownload( required function callback, string path = "" ) {
		var trigger  = arguments.callback
		var download = tryAction( () => variables.java.waitForDownload( () => trigger() ), "waitForDownload()" )
		var saved    = download.path().toString()
		if ( len( arguments.path ) ) {
			saved = expandPath( arguments.path )
			download.saveAs( createObject( "java", "java.io.File" ).init( saved ).toPath() )
		}
		return {
			path              : saved,
			suggestedFilename : download.suggestedFilename(),
			url               : download.url()
		}
	}

	/**
	 * --------------------------------------------------------------------------
	 * JavaScript
	 * --------------------------------------------------------------------------
	 */

	/**
	 * Run JavaScript in the page and return the (serializable) result.
	 *
	 * @script An expression or a function, e.g. "document.title" or "( n ) => n * 2"
	 * @arg    An optional argument passed to the function
	 */
	function evaluate( required string script, any arg ) {
		var code = arguments.script
		if ( isNull( arguments.arg ) ) {
			return tryAction( () => variables.java.evaluate( code ), "evaluate()" )
		}
		var value = arguments.arg
		return tryAction( () => variables.java.evaluate( code, value ), "evaluate()" )
	}

	/**
	 * --------------------------------------------------------------------------
	 * Output
	 * --------------------------------------------------------------------------
	 */

	/**
	 * Take a screenshot.
	 *
	 * @path    The file path, or empty to return the image bytes
	 * @options fullPage, type (png, jpeg, webp), quality, clip, omitBackground, animations,
	 *          mask (smart selectors or Locators to paint over)
	 *
	 * @return The path, or the bytes when no path is given
	 */
	function screenshot( string path = "", struct options = {} ) {
		// Shallow copy: the options can hold Java objects (mask locators) that cannot be duplicated
		var values = structCopy( arguments.options )
		if ( values.keyExists( "mask" ) ) {
			values.mask = maskLocators( values.mask )
		}
		if ( len( arguments.path ) ) {
			values.path = expandPath( arguments.path )
		}
		var opts  = buildOptions( "Page.ScreenshotOptions", values )
		var bytes = tryAction( () => variables.java.screenshot( opts ), "screenshot()" )
		if ( len( arguments.path ) ) {
			announceEvent( "onPlaywrightArtifact", { type : "screenshot", path : values.path, page : this } )
			return values.path
		}
		return bytes
	}

	/**
	 * Save the page as PDF (Chromium only).
	 *
	 * @path    The file path, or empty to return the PDF bytes
	 * @options format (A4, Letter, ...), landscape, margin { top, right, bottom, left }, printBackground,
	 *          headerTemplate, footerTemplate, displayHeaderFooter, scale, pageRanges, width, height
	 *
	 * @return The path, or the bytes when no path is given
	 */
	function pdf( string path = "", struct options = {} ) {
		if ( getConfig().browser != "chromium" ) {
			throw(
				type    = "Playwright.InvalidOption",
				message = "PDF generation only works with Chromium (current browser: #getConfig().browser#).",
				detail  = "Use playwright( ""print"" ) or the chromium browser."
			)
		}
		var values = duplicate( arguments.options )
		if ( len( arguments.path ) ) {
			values.path = expandPath( arguments.path )
		}
		var opts  = buildOptions( "Page.PdfOptions", values )
		var bytes = tryAction( () => variables.java.pdf( opts ), "pdf()" )
		if ( len( arguments.path ) ) {
			announceEvent( "onPlaywrightArtifact", { type : "pdf", path : values.path, page : this } )
			return values.path
		}
		return bytes
	}

	/**
	 * --------------------------------------------------------------------------
	 * Events and network
	 * --------------------------------------------------------------------------
	 */

	/**
	 * Listen to console messages.
	 *
	 * @callback Receives { type, text, location }
	 */
	function onConsole( required function callback ) {
		var listener = arguments.callback
		variables.java.onConsoleMessage( ( message ) => listener( {
			type     : message.type(),
			text     : message.text(),
			location : message.location()
		} ) )
		return this
	}

	/**
	 * Listen to uncaught JavaScript errors.
	 *
	 * @callback Receives { message, stack }
	 */
	function onPageError( required function callback ) {
		var listener = arguments.callback
		variables.java.onPageError( ( error ) => listener( { message : error, stack : "" } ) )
		return this
	}

	/**
	 * Listen to dialogs (alert, confirm, prompt). Without a listener Playwright dismisses them.
	 *
	 * @callback Receives the Playwright Dialog: call accept(), accept( text ) or dismiss()
	 */
	function onDialog( required function callback ) {
		variables.java.onDialog( arguments.callback )
		return this
	}

	/**
	 * Listen to requests.
	 *
	 * @callback Receives { url, method, resourceType }
	 */
	function onRequest( required function callback ) {
		var listener = arguments.callback
		variables.java.onRequest( ( request ) => listener( {
			url          : request.url(),
			method       : request.method(),
			resourceType : request.resourceType()
		} ) )
		return this
	}

	/**
	 * Listen to responses.
	 *
	 * @callback Receives { url, status, ok }
	 */
	function onResponse( required function callback ) {
		var listener = arguments.callback
		variables.java.onResponse( ( response ) => listener( {
			url    : response.url(),
			status : response.status(),
			ok     : response.ok()
		} ) )
		return this
	}

	/**
	 * Intercept requests matching a URL pattern (glob, full URL or regex()) and mock or block them.
	 *
	 * <pre>
	 * page.intercept( "**\/api/users" ).respondJson( { users : [] } )
	 * page.intercept( "**\/*.png" ).abort()
	 * </pre>
	 *
	 * @pattern The URL pattern
	 *
	 * @return A Route builder
	 */
	function intercept( required any pattern ) {
		return new models.Route@playwright( variables.java, arguments.pattern, this )
	}

	/**
	 * --------------------------------------------------------------------------
	 * Assertions
	 * --------------------------------------------------------------------------
	 */

	/**
	 * The page title is exactly this (or matches a regex()).
	 *
	 * @title The title
	 */
	function assertTitle( required any title ) {
		expect().toHaveTitle( arguments.title )
		return this
	}

	/**
	 * The page title contains the text.
	 *
	 * @text The text
	 */
	function assertTitleContains( required string text ) {
		expect().toHaveTitle( regex( ".*" & quoteRegex( arguments.text ) & ".*", "s" ) )
		return this
	}

	/**
	 * The full URL is exactly this (or matches a regex()).
	 *
	 * @url The URL
	 */
	function assertUrlIs( required any url ) {
		expect().toHaveURL( arguments.url )
		return this
	}

	/**
	 * The URL path is exactly this (case sensitive), ignoring the scheme, host, query string and hash.
	 * Works for URLs without a host too, such as file:///tmp/report.html.
	 *
	 * @path The path, e.g. /dashboard
	 */
	function assertPathIs( required string path ) {
		expect().toHaveURL( regex( "^[a-zA-Z][a-zA-Z0-9+.-]*://[^/]*" & quoteRegex( arguments.path ) & "(\?.*)?(##.*)?$" ) )
		return this
	}

	/**
	 * The URL contains the text.
	 *
	 * @text The text
	 */
	function assertUrlContains( required string text ) {
		expect().toHaveURL( regex( ".*" & quoteRegex( arguments.text ) & ".*" ) )
		return this
	}

	/**
	 * The accessibility tree of the page (or of an element) as compact YAML.
	 * In ai mode every element gets a ref ([ref=e12]) usable as a selector: page.click( "ref=e12" ).
	 *
	 * @selector Smart selector, empty for the whole page
	 * @options  mode (default or ai), depth
	 */
	string function snapshot( string selector = "", struct options = {} ) {
		if ( len( arguments.selector ) ) {
			return super.snapshot( arguments.selector, arguments.options )
		}
		var opts = buildOptions( "Page.AriaSnapshotOptions", arguments.options )
		return tryAction( () => variables.java.ariaSnapshot( opts ), "snapshot()" )
	}

	/**
	 * --------------------------------------------------------------------------
	 * Emulation and time
	 * --------------------------------------------------------------------------
	 */

	/**
	 * Resize the viewport.
	 *
	 * @width  Pixels
	 * @height Pixels
	 */
	function setViewport( required numeric width, required numeric height ) {
		variables.java.setViewportSize( javacast( "int", arguments.width ), javacast( "int", arguments.height ) )
		return this
	}

	/**
	 * Emulate media features.
	 *
	 * @options media (screen, print), colorScheme (light, dark, no-preference), reducedMotion (reduce, no-preference),
	 *          forcedColors (active, none), contrast (more, no-preference)
	 */
	function emulate( required struct options ) {
		variables.java.emulateMedia( buildOptions( "Page.EmulateMediaOptions", arguments.options ) )
		return this
	}

	/**
	 * The Playwright Clock of the page, for fine-grained control of time beyond the DSL helpers.
	 *
	 * @return The Playwright Clock, to control Date, timers and animations
	 */
	function clock() {
		return variables.java.clock()
	}

	/**
	 * Freeze the page time: Date.now() always returns this moment (timers keep running).
	 *
	 * @dateTime An ISO string such as 2026-01-01T09:00:00, a BoxLang date (now(), createDateTime()) or a java.util.Date
	 */
	function freezeTime( required any dateTime ) {
		var moment = arguments.dateTime
		if ( isInstanceOf( moment, "java.util.Date" ) ) {
			moment = javacast( "long", moment.getTime() )
		} else if ( !isInstanceOf( moment, "java.lang.String" ) && isDate( moment ) ) {
			// BoxLang dates are simple values too: send the instant, not their {ts '...'} string
			moment = javacast( "long", moment.toEpochMillis() )
		} else {
			// Playwright parses ISO strings itself
			moment = toString( moment )
		}
		variables.java.clock().setFixedTime( moment )
		return this
	}

	/**
	 * --------------------------------------------------------------------------
	 * Quality checks
	 * --------------------------------------------------------------------------
	 */

	/**
	 * The JavaScript errors of this page so far: console.error() messages and uncaught exceptions.
	 *
	 * @return An array of error messages
	 */
	array function consoleErrors() {
		var messages = []
		messages.append( variables.java.consoleMessages(), true )
		var errors = messages
			.filter( ( message ) -> message.type() == "error" )
			.map( ( message ) -> message.text() )
		errors.append( variables.java.pageErrors(), true )
		return errors
	}

	/**
	 * No console errors or uncaught exceptions happened on this page.
	 *
	 * @ignore Substrings of errors to ignore, e.g. [ "favicon.ico" ]
	 */
	function assertNoConsoleErrors( array ignore = [] ) {
		var skip   = arguments.ignore
		var errors = consoleErrors().filter( ( error ) => !skip.some( ( pattern ) => error contains pattern ) )
		if ( errors.len() ) {
			failAssertion(
				"The page has #errors.len()# JavaScript error(s): #errors.toList( " | " )#",
				"Fix the errors, or ignore known ones: assertNoConsoleErrors( [ ""favicon.ico"" ] )"
			)
		}
		return this
	}

	/**
	 * Smoke test: visit each URL and check it answers below 400 without JavaScript errors.
	 * All URLs are checked before failing, and the failure lists every problem.
	 *
	 * <pre>
	 * page.assertNoSmoke( [ "/", "/about", "/pricing" ] )
	 * </pre>
	 *
	 * @urls    URLs or paths (relative to baseURL). Empty checks the current page
	 * @options ignore (error substrings to ignore), waitUntil (load by default)
	 */
	function assertNoSmoke( array urls = [], struct options = {} ) {
		var skip     = arguments.options.ignore ?: []
		var problems = []
		var targets  = arguments.urls.len() ? arguments.urls : [ url() ]
		for ( var target in targets ) {
			var navigation = buildOptions( "Page.NavigateOptions", { waitUntil : arguments.options.waitUntil ?: "load" } )
			var response   = nullValue()
			try {
				response = variables.java.navigate( target, navigation )
			} catch ( any e ) {
				problems.append( "#target#: #tryMessage( e )#" )
				continue
			}
			if ( !isNull( response ) && response.status() >= 400 ) {
				problems.append( "#target#: HTTP #response.status()#" )
			}
			// Playwright clears console messages and page errors on navigation: every error listed belongs to this URL
			for ( var error in consoleErrors() ) {
				if ( !skip.some( ( pattern ) => error contains pattern ) ) {
					problems.append( "#target#: #error#" )
				}
			}
		}
		if ( problems.len() ) {
			failAssertion(
				"Smoke test found #problems.len()# problem(s): #problems.toList( " | " )#",
				"Checked: #targets.toList( ", " )#"
			)
		}
		return this
	}

	/**
	 * Run the axe-core accessibility audit on the page.
	 *
	 * @options tags (e.g. [ "wcag2a", "wcag2aa" ]), exclude (rule ids to skip), include (a CSS selector to audit)
	 *
	 * @return An array of violations: { id, impact, description, help, helpUrl, nodes : [ { target, html, summary } ] }
	 */
	array function accessibility( struct options = {} ) {
		injectAxe()
		var axeOptions = {}
		if ( ( arguments.options.tags ?: [] ).len() ) {
			axeOptions[ "runOnly" ] = { "type" : "tag", "values" : arguments.options.tags }
		}
		if ( ( arguments.options.exclude ?: [] ).len() ) {
			axeOptions[ "rules" ] = {}
			for ( var rule in arguments.options.exclude ) {
				axeOptions.rules[ rule ] = { "enabled" : false }
			}
		}
		var payload = jsonSerialize( { "context" : arguments.options.include ?: "", "options" : axeOptions } )
		var script  = "( json ) => { const input = JSON.parse( json ); return axe.run( input.context || document, input.options ).then( result => result.violations.map( v => ( { id : v.id, impact : v.impact || '', description : v.description, help : v.help, helpUrl : v.helpUrl, nodes : v.nodes.map( n => ( { target : n.target.join( ' ' ), html : n.html, summary : n.failureSummary || '' } ) ) } ) ) ) }"
		return tryAction( () => variables.java.evaluate( script, payload ), "accessibility()" )
	}

	/**
	 * No accessibility violations at or above an impact level.
	 *
	 * @options tags, exclude, include (see accessibility()), impact: the minimum impact that fails
	 *          (minor, moderate, serious, critical; default minor = everything)
	 */
	function assertNoAccessibilityIssues( struct options = {} ) {
		var levels     = [ "minor", "moderate", "serious", "critical" ]
		var minimum    = levels.findNoCase( arguments.options.impact ?: "minor" ) ?: 1
		var violations = accessibility( arguments.options ).filter( ( violation ) => max( 1, levels.findNoCase( violation.impact ) ) >= minimum )
		if ( violations.len() ) {
			var lines = violations.map( ( violation ) => "#violation.id# (#violation.impact#): #violation.help# at #violation.nodes.map( ( node ) -> node.target ).toList( ", " )#" )
			failAssertion(
				"#violations.len()# accessibility issue(s): #lines.toList( " | " )#",
				"See each rule at https://dequeuniversity.com/rules/axe. Skip rules with { exclude : [ ""rule-id"" ] } or raise { impact : ""serious"" }."
			)
		}
		return this
	}

	/**
	 * --------------------------------------------------------------------------
	 * Lifecycle
	 * --------------------------------------------------------------------------
	 */

	/**
	 * Close the page and its browser context. The playwright() manager stays open.
	 */
	function close() {
		variables.context.close()
	}

	/**
	 * Close everything: the page, its context, the browser and the playwright() manager.
	 */
	function quit() {
		variables.context.manager().close()
	}

	/**
	 * Whether the page has been closed.
	 *
	 * @return True if the page is closed
	 */
	boolean function isClosed() {
		return variables.java.isClosed()
	}

	/**
	 * Load the bundled axe-core script into the page, unless window.axe is already defined.
	 */
	private function injectAxe() {
		if ( variables.java.evaluate( "typeof window.axe !== 'undefined'" ) ) {
			return
		}
		var source = fileRead( manager().getConfigService().modulePath() & "/resources/axe.min.js" )
		variables.java.addScriptTag( buildOptions( "Page.AddScriptTagOptions", { content : source } ) )
	}

	/**
	 * The first line of the root cause message of an exception.
	 *
	 * @error The caught exception
	 *
	 * @return The message line
	 */
	private string function tryMessage( required any error ) {
		return PlaywrightErrors.rootMessage( arguments.error ).listFirst( char( 10 ) )
	}

	/**
	 * Escape regex special characters. Playwright runs regexes in the browser, so Java's \Q...\E quoting cannot be used.
	 *
	 * @text The literal text
	 *
	 * @return The text with regex special characters escaped
	 */
	private string function quoteRegex( required string text ) {
		return arguments.text.reReplace( "([.*+?^$\{\}()|\[\]\\/])", "\\\1", "all" )
	}

}
