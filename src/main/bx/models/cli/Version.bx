/**
 * `bxPlaywright version`: module, Playwright and Node.js versions.
 */
class {

	/**
	 * Report the module, Playwright, Node.js (the runtime actually used, or none) and installed browser versions.
	 *
	 * @options CLI options
	 * @config  The models.Config
	 * @verb    The verb registry entry
	 *
	 * @return { exitCode, message, data }
	 */
	struct function run( required struct options, required any config, struct verb = {} ) {
		var home  = arguments.config.home()
		var build = arguments.config.buildInfo()
		var node  = new models.cli.Terminal@playwright().node( home, arguments.config.nodePath() )
		var data  = {
			"module"       : build.module,
			"distribution" : build.distribution,
			"playwright"   : build.playwright,
			"node"         : node.ok ? node.version : "",
			"nodeSource"   : node.ok ? node.source : "",
			"browsers"     : home.installedBrowsers()
		}
		var nodeText = node.ok ? "#data.node# (#data.nodeSource#)" : "none"
		return {
			exitCode : 0,
			message  : "bx-playwright #data.module# (#data.distribution#), Playwright #data.playwright#, Node.js #nodeText#, browsers: #data.browsers.len() ? data.browsers.toList( ", " ) : "none"#",
			data     : data
		}
	}

}
