/**
 * The `bxplaywright` command line.
 *
 * Every verb is a class in models/cli with a `run( options, config )` method returning
 * `{ exitCode, message, data }`. Options follow the BoxLang CLI conventions:
 *
 * - `--flag`          -> true
 * - `--flag=value`    -> value
 * - `--flag value`    -> value, for the flags a verb declares in `values` (short aliases such as `-o` too)
 * - `--no-flag`       -> false
 * - anything else     -> a positional, collected in order in `_positionals`
 *
 * Built-in verbs reject flags they do not declare. Verbs that forward to Playwright accept anything.
 * `--json` prints the verb's `data` as JSON instead of the human readable message, errors included.
 */
class {

	/**
	 * Class constants: the browsers, the shells with completions and the verb registry.
	 */
	static {
		/**
		 * Browsers accepted by install and uninstall.
		 */
		BROWSERS = [ "chromium", "firefox", "webkit", "chrome", "chrome-beta", "msedge", "all" ]

		/**
		 * Shells with a tab completion script.
		 */
		SHELLS = [ "bash", "zsh", "fish", "powershell" ]

		/**
		 * The verb registry. It drives dispatch, help and the tab completions of every shell.
		 */
		VERBS = {
			"install"      : {
				class       : "Install",
				description : "Set up the driver and Node.js, then install browsers (default: chromium)",
				usage       : "install [browsers...] [--with-deps] [--only-shell] [--force] [--skip-node]",
				flags       : [ "--with-deps", "--only-shell", "--force", "--skip-node", "--json" ],
				words       : static.BROWSERS
			},
			"install-node" : {
				class       : "InstallNode",
				description : "Download the Node.js runtime only (small distribution)",
				usage       : "install-node [--force]",
				flags       : [ "--force", "--json" ],
				words       : []
			},
			"install-deps" : {
				class       : "Passthrough",
				command     : "install-deps",
				description : "Install the operating system packages browsers need (Linux)",
				usage       : "install-deps [browsers...]",
				flags       : [],
				words       : static.BROWSERS
			},
			"uninstall"    : {
				class       : "Passthrough",
				command     : "uninstall",
				description : "Remove installed browsers",
				usage       : "uninstall [--all]",
				flags       : [ "--all" ],
				words       : []
			},
			"doctor"       : {
				class       : "Doctor",
				description : "Check versions, paths, Node.js and browsers, with fix hints",
				usage       : "doctor [--json]",
				flags       : [ "--json" ],
				words       : []
			},
			"version"      : {
				class       : "Version",
				description : "Show the module, Playwright and Node.js versions",
				usage       : "version [--json]",
				flags       : [ "--json" ],
				words       : []
			},
			"clean"        : {
				class       : "Clean",
				description : "Remove the extracted driver and downloaded Node.js (browsers are kept)",
				usage       : "clean [--json]",
				flags       : [ "--json" ],
				words       : []
			},
			"devices"      : {
				class       : "DevicesList",
				description : "List the device descriptors usable in the device setting",
				usage       : "devices [--json]",
				flags       : [ "--json" ],
				words       : []
			},
			"profiles"     : {
				class       : "ProfilesList",
				description : "List profiles, or show one fully resolved",
				usage       : "profiles [name] [--json]",
				flags       : [ "--json" ],
				words       : "@profiles"
			},
			"codegen"      : {
				class       : "Codegen",
				description : "Record browser actions and generate BoxLang code (or --target=java, javascript, python)",
				usage       : "codegen [url] [--output=file.bxs|-o file.bxs] [--target=boxlang] [--device=name] [--viewport-size=w,h] [--load-storage=file] [--save-storage=file]",
				flags       : [ "--output", "--target", "--device", "--viewport-size", "--load-storage", "--save-storage" ],
				values      : [ "--output", "--target", "--device", "--viewport-size", "--load-storage", "--save-storage" ],
				aliases     : { "-o" : "--output" },
				forwards    : true,
				words       : []
			},
			"open"         : {
				class       : "Passthrough",
				command     : "open",
				description : "Open a headed browser",
				usage       : "open [url]",
				flags       : [ "--device", "--browser" ],
				values      : [ "--device", "--browser" ],
				words       : []
			},
			"screenshot"   : {
				class       : "Passthrough",
				command     : "screenshot",
				description : "Take a screenshot of a URL",
				usage       : "screenshot <url> <file> [--full-page] [--device=name]",
				flags       : [ "--full-page", "--device", "--browser" ],
				values      : [ "--device", "--browser" ],
				words       : "@files"
			},
			"pdf"          : {
				class       : "Passthrough",
				command     : "pdf",
				description : "Save a URL as PDF (Chromium)",
				usage       : "pdf <url> <file> [--paper-format=A4]",
				flags       : [ "--paper-format" ],
				values      : [ "--paper-format" ],
				words       : "@files"
			},
			"show-trace"   : {
				class       : "Passthrough",
				command     : "show-trace",
				description : "Open the trace viewer",
				usage       : "show-trace [trace.zip]",
				flags       : [],
				words       : "@files"
			},
			"mcp"          : {
				class       : "Passthrough",
				command     : "mcp",
				description : "Start the Playwright MCP server for AI agents",
				usage       : "mcp [options]",
				flags       : [ "--headless", "--browser", "--port" ],
				values      : [ "--browser", "--port" ],
				words       : []
			},
			"run"          : {
				class       : "Passthrough",
				command     : "",
				description : "Run any Playwright CLI command as-is",
				usage       : "run <playwright cli arguments...>",
				flags       : [],
				words       : []
			},
			"completions"  : {
				class       : "Completions",
				description : "Print the tab completion script for bash (default), zsh, fish or powershell",
				usage       : "completions [bash|zsh|fish|powershell]",
				flags       : [],
				words       : static.SHELLS
			},
			"help"         : {
				class       : "",
				description : "Show help for all verbs or one verb",
				usage       : "help [verb] [--json]",
				flags       : [ "--json" ],
				words       : "@verbs"
			}
		}
	}

	/**
	 * Create the CLI dispatcher.
	 *
	 * @config The configuration to use. Defaults to the loaded module settings
	 */
	function init( any config ) {
		variables.config = arguments.config ?: nullValue()
		return this
	}

	/**
	 * Run the CLI.
	 *
	 * @args The CLI arguments (verb first)
	 *
	 * @return The exit code
	 */
	numeric function run( array args = [] ) {
		var first   = arrayLen( arguments.args ) ? arguments.args[ 1 ] : ""
		var rest    = arguments.args.len() > 1 ? arguments.args.slice( 2 ) : []
		var json    = rest.findNoCase( "--json" ) > 0
		var options = { json : json }

		if ( first == "--version" || first == "-v" ) {
			first = "version"
		}
		if ( !len( first ) || first == "--help" || first == "-h" ) {
			printUsage()
			return len( first ) ? 0 : 1
		}

		try {
			if ( first == "help" ) {
				options = parseOptions( rest, static.VERBS.help )
				validateOptions( "help", static.VERBS.help, options )
				return help( options )
			}
			if ( !static.VERBS.keyExists( first ) ) {
				if ( !json ) {
					println( "Unknown verb [#first#]." )
					println( "" )
					printUsage()
					return 1
				}
				throw(
					type    = "Playwright.InvalidOption",
					message = "Unknown verb [#first#].",
					detail  = "Run [bxplaywright help] to list the verbs."
				)
			}
			if ( first != "run" && ( rest.findNoCase( "--help" ) || rest.findNoCase( "-h" ) ) ) {
				return help( { _positionals : [ first ], json : json } )
			}

			var verb = static.VERBS[ first ]
			options  = parseOptions( rest, verb )
			if ( isStrict( verb ) ) {
				validateOptions( first, verb, options )
			}
			options._verb = first
			options._raw  = rest

			var result = new "models.cli.#verb.class#@bxplaywright"().run( options, getConfig(), verb )
			return output( result, options.json ?: false )
		} catch ( any e ) {
			return printError( e, options.json ?: json )
		}
	}

	/**
	 * Parse CLI arguments into an options struct.
	 *
	 * @args The arguments after the verb
	 * @verb The verb registry entry: its `values` flags take the next argument as their value and its `aliases` map short flags to long ones
	 *
	 * @return The options, with positionals in `_positionals`
	 *
	 * @throws Playwright.InvalidOption when a value flag has no value
	 */
	struct function parseOptions( array args = [], struct verb = {} ) {
		var options = { _positionals : [] }
		for ( var token in tokenize( arguments.args, arguments.verb ) ) {
			if ( token.keyExists( "name" ) ) {
				options[ token.name ] = token.value
			} else {
				options._positionals.append( token.value )
			}
		}
		return options
	}

	/**
	 * Remove options (and the values they consumed) from raw CLI arguments, keeping everything else in order.
	 * Used to forward arguments to Playwright without the options bxplaywright handles itself.
	 *
	 * @args  The raw arguments after the verb
	 * @names The option names to remove, without dashes, e.g. [ "output", "json" ]
	 * @verb  The verb registry entry (`values` and `aliases`)
	 *
	 * @return The remaining raw arguments
	 */
	array function withoutOptions( array args = [], array names = [], struct verb = {} ) {
		var kept = []
		for ( var token in tokenize( arguments.args, arguments.verb ) ) {
			if ( !token.keyExists( "name" ) || !arguments.names.findNoCase( token.name ) ) {
				kept.append( token.raw, true )
			}
		}
		return kept
	}

	/**
	 * Get the registry of CLI verbs.
	 *
	 * @return The verb registry
	 */
	struct function getVerbs() {
		return static.VERBS
	}

	/**
	 * Build the tab completion script of a shell from the verb registry.
	 *
	 * @shell One of `bash`, `zsh`, `fish` or `powershell`
	 *
	 * @return The completion script, ending with a new line
	 *
	 * @throws Playwright.InvalidOption when the shell is not supported
	 */
	string function completionScript( string shell = "bash" ) {
		switch ( lCase( arguments.shell ) ) {
			case "bash":
				return bashCompletions()
			case "zsh":
				return zshCompletions()
			case "fish":
				return fishCompletions()
			case "powershell":
				return powershellCompletions()
		}
		throw(
			type    = "Playwright.InvalidOption",
			message = "Unknown shell [#arguments.shell#].",
			detail  = "Use one of #static.SHELLS.toList( ", " )#: bxplaywright completions <shell>"
		)
	}

	/**
	 * --------------------------------------------------------------------------
	 * Private
	 * --------------------------------------------------------------------------
	 */

	/**
	 * The words a verb completes after its name: its flags, then its own words (browsers, profiles or verb names).
	 *
	 * @name The verb name
	 *
	 * @return The completion words, flags first
	 */
	private array function completionWords( required string name ) {
		var verb  = static.VERBS[ arguments.name ]
		var words = verb.flags.duplicate()
		if ( isArray( verb.words ) ) {
			words.append( verb.words, true )
		} else if ( verb.words == "@profiles" ) {
			words.append( new models.Profiles@bxplaywright().builtIn().keyArray().sort( "textnocase" ), true )
		} else if ( verb.words == "@verbs" ) {
			words.append( static.VERBS.keyArray().sort( "textnocase" ), true )
		}
		return words
	}

	/**
	 * Whether a verb also completes file paths.
	 *
	 * @name The verb name
	 *
	 * @return True when the verb takes files
	 */
	private boolean function completesFiles( required string name ) {
		return isSimpleValue( static.VERBS[ arguments.name ].words ) && static.VERBS[ arguments.name ].words == "@files"
	}

	/**
	 * The bash completion script. install-bx-module installs it from completions/bxplaywright.bash.
	 *
	 * @return The script
	 */
	private string function bashCompletions() {
		var nl    = char( 10 )
		var names = static.VERBS.keyArray().sort( "textnocase" )
		var lines = [
			"##!/usr/bin/env bash",
			"## bxplaywright bash completions. Generated by `bxplaywright completions`, do not edit.",
			"_bxplaywright_complete() {",
			"	local cur verb",
			"	cur=""${COMP_WORDS[COMP_CWORD]}""",
			"	verb=""${COMP_WORDS[1]}""",
			"	if [[ ${COMP_CWORD} -eq 1 ]]; then",
			"		COMPREPLY=( $(compgen -W ""#names.toList( " " )# --help --version"" -- ""$cur"") )",
			"		return 0",
			"	fi",
			"	case ""$verb"" in"
		]
		for ( var name in names ) {
			var words = completionWords( name )
			if ( completesFiles( name ) ) {
				lines.append( "		#name#) COMPREPLY=( $(compgen -W ""#words.toList( " " )#"" -- ""$cur"") $(compgen -f -- ""$cur"") ) ;;" )
			} else {
				lines.append( "		#name#) COMPREPLY=( $(compgen -W ""#words.toList( " " )#"" -- ""$cur"") ) ;;" )
			}
		}
		lines.append( "		*) COMPREPLY=() ;;" )
		lines.append( "	esac" )
		lines.append( "}" )
		lines.append( "complete -F _bxplaywright_complete bxplaywright" )
		return lines.toList( nl ) & nl
	}

	/**
	 * The zsh completion script. Works sourced, or saved as _bxplaywright in a folder of $fpath.
	 *
	 * @return The script
	 */
	private string function zshCompletions() {
		var nl    = char( 10 )
		var names = static.VERBS.keyArray().sort( "textnocase" )
		var lines = [
			"##compdef bxplaywright",
			"## bxplaywright zsh completions. Generated by `bxplaywright completions zsh`, do not edit.",
			"## Load: source <(bxplaywright completions zsh), or save it as _bxplaywright in a folder of $fpath.",
			"_bxplaywright() {",
			"	local -a verbs",
			"	verbs=("
		]
		for ( var name in names ) {
			lines.append( "		'#name#:#replace( static.VERBS[ name ].description, "'", "'\''", "all" )#'" )
		}
		lines.append( "	)" )
		lines.append( "	if (( CURRENT == 2 )); then" )
		lines.append( "		_describe -t commands 'bxplaywright verb' verbs" )
		lines.append( "		compadd -- --help --version" )
		lines.append( "		return" )
		lines.append( "	fi" )
		lines.append( "	case ""${words[2]}"" in" )
		for ( var name in names ) {
			var words = completionWords( name )
			var steps = []
			if ( words.len() ) {
				steps.append( "compadd -- #words.toList( " " )#" )
			}
			if ( completesFiles( name ) ) {
				steps.append( "_files" )
			}
			lines.append( "		#name#) #steps.len() ? steps.toList( "; " ) : ":"# ;;" )
		}
		lines.append( "	esac" )
		lines.append( "}" )
		lines.append( "if [[ ""${funcstack[1]}"" == ""_bxplaywright"" ]]; then" )
		lines.append( "	_bxplaywright ""$@""" )
		lines.append( "else" )
		lines.append( "	compdef _bxplaywright bxplaywright" )
		lines.append( "fi" )
		return lines.toList( nl ) & nl
	}

	/**
	 * The fish completion script.
	 *
	 * @return The script
	 */
	private string function fishCompletions() {
		var nl    = char( 10 )
		var names = static.VERBS.keyArray().sort( "textnocase" )
		var lines = [
			"## bxplaywright fish completions. Generated by `bxplaywright completions fish`, do not edit.",
			"## Load: bxplaywright completions fish > ~/.config/fish/completions/bxplaywright.fish",
			"complete -c bxplaywright -f",
			"complete -c bxplaywright -n __fish_use_subcommand -l help -d 'Show help'",
			"complete -c bxplaywright -n __fish_use_subcommand -l version -d 'Show the version'"
		]
		for ( var name in names ) {
			var description = replace( replace( static.VERBS[ name ].description, "\", "\\", "all" ), "'", "\'", "all" )
			lines.append( "complete -c bxplaywright -n __fish_use_subcommand -a #name# -d '#description#'" )
		}
		for ( var name in names ) {
			var verb      = static.VERBS[ name ]
			var condition = "-n '__fish_seen_subcommand_from #name#'"
			for ( var flag in verb.flags ) {
				lines.append( "complete -c bxplaywright #condition# -l #flag.reReplace( "^--", "" )#" )
			}
			var words = completionWords( name ).filter( ( word ) -> !word.startsWith( "--" ) )
			if ( words.len() ) {
				lines.append( "complete -c bxplaywright #condition# -a '#words.toList( " " )#'" )
			}
			if ( completesFiles( name ) ) {
				lines.append( "complete -c bxplaywright #condition# -F" )
			}
		}
		return lines.toList( nl ) & nl
	}

	/**
	 * The PowerShell completion script. When nothing matches, PowerShell falls back to file names.
	 *
	 * @return The script
	 */
	private string function powershellCompletions() {
		var nl    = char( 10 )
		var names = static.VERBS.keyArray().sort( "textnocase" )
		var lines = [
			"## bxplaywright PowerShell completions. Generated by `bxplaywright completions powershell`, do not edit.",
			"## Load: bxplaywright completions powershell | Out-String | Invoke-Expression, or add that line to your $PROFILE",
			"Register-ArgumentCompleter -Native -CommandName bxplaywright -ScriptBlock {",
			"	param( $wordToComplete, $commandAst, $cursorPosition )",
			"	$verbs = [ordered]@{"
		]
		for ( var name in names ) {
			lines.append( "		'#name#' = '#replace( static.VERBS[ name ].description, "'", "''", "all" )#'" )
		}
		lines.append( "	}" )
		lines.append( "	$words = @{" )
		for ( var name in names ) {
			var words = completionWords( name ).map( ( word ) -> "'#word#'" )
			lines.append( "		'#name#' = @( #words.toList( ", " )# )" )
		}
		lines.append( "	}" )
		lines.append( "	$elements = @( $commandAst.CommandElements | ForEach-Object { $_.ToString() } )" )
		lines.append( "	if ( $elements.Count -le 1 -or ( $elements.Count -eq 2 -and $wordToComplete ) ) {" )
		lines.append( "		$candidates = @( $verbs.Keys ) + @( '--help', '--version' )" )
		lines.append( "	} else {" )
		lines.append( "		$candidates = $words[ $elements[ 1 ] ]" )
		lines.append( "	}" )
		lines.append( "	$candidates | Where-Object { $_ -like ""$wordToComplete*"" } | ForEach-Object {" )
		lines.append( "		$tip = if ( $verbs.Contains( $_ ) ) { $verbs[ $_ ] } else { $_ }" )
		lines.append( "		[System.Management.Automation.CompletionResult]::new( $_, $_, 'ParameterValue', $tip )" )
		lines.append( "	}" )
		lines.append( "}" )
		return lines.toList( nl ) & nl
	}


	/**
	 * Get the configuration, lazily creating one from the module settings when none was given.
	 *
	 * @return The configuration
	 */
	private function getConfig() {
		if ( isNull( variables.config ) ) {
			variables.config = new models.Config@bxplaywright()
		}
		return variables.config
	}

	/**
	 * Print a verb result: its data as JSON when requested, otherwise its message.
	 *
	 * @result The verb result (`message`, `data`, `exitCode`)
	 * @json   Whether to print JSON output
	 *
	 * @return The result's exit code (0 when not set)
	 */
	private numeric function output( required struct result, boolean json = false ) {
		if ( arguments.json ) {
			println( jsonSerialize( arguments.result.data ?: { "message" : arguments.result.message ?: "" } ) )
		} else if ( len( arguments.result.message ?: "" ) ) {
			println( arguments.result.message )
		}
		return arguments.result.exitCode ?: 0
	}

	/**
	 * Print help for all verbs, or for the verb named by the first positional, as text or JSON.
	 *
	 * @options The parsed options (`_positionals`, `json`)
	 *
	 * @return The exit code (1 when the verb is unknown)
	 *
	 * @throws Playwright.InvalidOption for an unknown verb with `--json`
	 */
	private numeric function help( required struct options ) {
		var target = options._positionals.len() ? options._positionals[ 1 ] : ""
		if ( len( target ) && !static.VERBS.keyExists( target ) && ( options.json ?: false ) ) {
			throw(
				type    = "Playwright.InvalidOption",
				message = "Unknown verb [#target#].",
				detail  = "Run [bxplaywright help] to list the verbs."
			)
		}
		if ( options.json ?: false ) {
			var data = {}
			for ( var name in static.VERBS ) {
				if ( !len( target ) || target == name ) {
					var verb     = static.VERBS[ name ]
					data[ name ] = {
						"description" : verb.description,
						"usage"       : "bxplaywright " & verb.usage,
						"flags"       : verb.flags
					}
				}
			}
			println( jsonSerialize( data ) )
			return 0
		}
		if ( len( target ) ) {
			if ( !static.VERBS.keyExists( target ) ) {
				println( "Unknown verb [#target#]." )
				return 1
			}
			var verb = static.VERBS[ target ]
			println( "bxplaywright #verb.usage#" )
			println( "" )
			println( "  #verb.description#" )
			return 0
		}
		printUsage()
		return 0
	}

	/**
	 * Print the general usage text listing every verb and the global options.
	 */
	private void function printUsage() {
		println( "bxplaywright - Fluent browser automation and testing for BoxLang, powered by Microsoft Playwright" )
		println( "" )
		println( "Usage: bxplaywright <verb> [options]" )
		println( "" )
		for ( var name in static.VERBS.keyArray().sort( "textnocase" ) ) {
			println( "  #name.lJustify( 14 )# #static.VERBS[ name ].description#" )
		}
		println( "" )
		println( "Global options:" )
		println( "  -h, --help     Show help (also: bxplaywright help <verb>)" )
		println( "  -v, --version  Show versions" )
		println( "  --json         Machine readable output, where supported" )
	}

	/**
	 * Remove surrounding quotes from a value that starts and ends with the same single or double quote.
	 *
	 * @value The value to unquote
	 *
	 * @return The value without its first and last characters when quoted, otherwise unchanged
	 */
	private string function stripQuotes( required string value ) {
		if ( arguments.value.len() < 2 ) {
			return arguments.value
		}
		var quote = arguments.value.left( 1 )
		if ( ( quote == """" || quote == "'" ) && arguments.value.right( 1 ) == quote ) {
			return arguments.value.mid( 2, arguments.value.len() - 2 )
		}
		return arguments.value
	}

	/**
	 * Split raw CLI arguments into options and positionals. Value flags declared by the verb take the next
	 * argument as their value (`--output file`), short aliases are expanded (`-o file` is `--output file`).
	 *
	 * @args The raw arguments after the verb
	 * @verb The verb registry entry (`values` and `aliases`)
	 *
	 * @return One struct per option ({ name, value, raw }) or positional ({ value, raw }), `raw` holds the consumed arguments
	 *
	 * @throws Playwright.InvalidOption when a value flag has no value
	 */
	private array function tokenize( required array args, required struct verb ) {
		var values  = arguments.verb.values ?: []
		var aliases = arguments.verb.aliases ?: {}
		var tokens  = []
		var i       = 1
		while ( i <= arguments.args.len() ) {
			var raw   = arguments.args[ i ]
			var token = raw
			var flag  = token.listFirst( "=" )
			if ( !token.startsWith( "--" ) && aliases.keyExists( flag ) ) {
				token = aliases[ flag ] & token.mid( flag.len() + 1, token.len() )
			}
			if ( token.startsWith( "--no-" ) ) {
				tokens.append( { name : token.mid( 6, token.len() ), value : false, raw : [ raw ] } )
			} else if ( token.startsWith( "--" ) ) {
				var body  = token.mid( 3, token.len() )
				var eqPos = body.find( "=" )
				if ( eqPos ) {
					tokens.append( { name : body.left( eqPos - 1 ), value : stripQuotes( body.mid( eqPos + 1, body.len() ) ), raw : [ raw ] } )
				} else if ( values.findNoCase( "--" & body ) ) {
					if ( i == arguments.args.len() || arguments.args[ i + 1 ].startsWith( "-" ) ) {
						throw(
							type    = "Playwright.InvalidOption",
							message = "The [#raw#] option needs a value.",
							detail  = "Pass it as [--#body#=value] or [--#body# value]."
						)
					}
					tokens.append( { name : body, value : arguments.args[ i + 1 ], raw : [ raw, arguments.args[ i + 1 ] ] } )
					i++
				} else {
					tokens.append( { name : body, value : true, raw : [ raw ] } )
				}
			} else {
				tokens.append( { value : raw, raw : [ raw ] } )
			}
			i++
		}
		return tokens
	}

	/**
	 * Whether a verb validates its flags: built-in verbs do, verbs that forward their arguments to Playwright do not.
	 *
	 * @verb The verb registry entry
	 *
	 * @return True when unknown flags must be rejected
	 */
	private boolean function isStrict( required struct verb ) {
		return arguments.verb.class != "Passthrough" && !( arguments.verb.forwards ?: false )
	}

	/**
	 * Reject flags a built-in verb does not declare, so a typo such as `--with-dep` fails instead of being ignored.
	 * `--json` is accepted by every verb.
	 *
	 * @name    The verb name
	 * @verb    The verb registry entry
	 * @options The parsed options
	 *
	 * @throws Playwright.InvalidOption for an unknown flag
	 */
	private void function validateOptions( required string name, required struct verb, required struct options ) {
		var allowed = arguments.verb.flags.duplicate()
		if ( !allowed.findNoCase( "--json" ) ) {
			allowed.append( "--json" )
		}
		var unknown = []
		for ( var key in arguments.options ) {
			if ( key != "_positionals" && !allowed.findNoCase( "--" & key ) ) {
				unknown.append( "--" & key )
			}
		}
		for ( var positional in arguments.options._positionals ) {
			if ( positional.len() > 1 && positional.startsWith( "-" ) ) {
				unknown.append( positional )
			}
		}
		if ( unknown.len() ) {
			throw(
				type    = "Playwright.InvalidOption",
				message = "Unknown option [#unknown.toList( ", " )#] for [#arguments.name#].",
				detail  = "Valid options: #allowed.toList( ", " )#. See [bxplaywright help #arguments.name#]."
			)
		}
	}

	/**
	 * Print an error as text (type and fix) or, with `--json`, as `{ "error" : { type, message, detail } }`.
	 *
	 * @error The caught exception
	 * @json  Whether to print JSON output
	 *
	 * @return The exit code, always 1
	 */
	private numeric function printError( required any error, boolean json = false ) {
		if ( arguments.json ) {
			println( jsonSerialize( { "error" : { "type" : arguments.error.type, "message" : arguments.error.message, "detail" : arguments.error.detail } } ) )
		} else {
			println( "Error [#arguments.error.type#]: #arguments.error.message#" )
			if ( len( arguments.error.detail ) ) {
				println( "Fix: #arguments.error.detail#" )
			}
		}
		return 1
	}

}
