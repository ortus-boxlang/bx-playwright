/**
 * `bxPlaywright codegen [url] [--target=boxlang] [--output=file.bxs] [playwright codegen options]`
 *
 * Opens a browser and records your actions. With the default boxlang target, the recorded code is
 * translated into the bx-playwright DSL when you close the browser. Any other target (java, javascript,
 * python, ...) is passed to Playwright as-is.
 */
class {

	/**
	 * @options CLI options, the raw arguments are in `_raw`
	 * @config  The models.Config
	 * @verb    The verb registry entry
	 *
	 * @return { exitCode, message, data }
	 */
	struct function run( required struct options, required any config, struct verb = {} ) {
		var target = arguments.options.target ?: "boxlang"
		if ( target != "boxlang" ) {
			var passthrough = [ "codegen" ]
			passthrough.append( arguments.options._raw, true )
			return { exitCode : arguments.config.home().runCli( passthrough ), message : "" }
		}

		var output   = arguments.options.output ?: ""
		var recorded = getTempDirectory() & "/bxplaywright-codegen-#createUUID()#.java"
		var cliArgs  = [ "codegen", "--target=java", "--output=#recorded#" ]
		for ( var token in arguments.options._raw ) {
			if ( !token.startsWith( "--target" ) && !token.startsWith( "--output" ) && !token.startsWith( "-o=" ) ) {
				cliArgs.append( token )
			}
		}
		println( "Recording. Interact with the browser, then close it to get BoxLang code." )
		var exitCode = arguments.config.home().runCli( cliArgs )
		if ( !fileExists( recorded ) ) {
			return { exitCode : exitCode ?: 1, message : "Nothing was recorded." }
		}
		var code = new models.cli.CodegenTranslator@playwright().translate( fileRead( recorded ) )
		fileDelete( recorded )
		if ( len( output ) ) {
			fileWrite( output, code )
			return { exitCode : 0, message : "BoxLang code written to #output#", data : { "output" : output, "code" : code } }
		}
		return { exitCode : 0, message : code, data : { "code" : code } }
	}

}
