import java:com.microsoft.playwright.assertions.PlaywrightAssertions@playwright;

/**
 * Web-first assertions: they retry until they pass or the assertion timeout expires.
 *
 * <pre>
 * page.expect( "h1" ).toHaveText( "Welcome" )
 * page.expect().toHaveTitle( "Home" ).toHaveURL( page.regex( "/home$" ) )
 * page.expect( "@error" ).not().toBeVisible()
 * </pre>
 *
 * Failures throw `Playwright.AssertionFailed` with Playwright's message (expected, received and call log).
 * Every method returns the Expect object so assertions can be chained; `not()` applies to the next assertion only.
 */
class extends="Base" {

	/**
	 * @target      A Page, a Locator, a Response, or the Java object they wrap
	 * @timeout     The assertion timeout in milliseconds
	 * @collector   An array that collects failures instead of throwing (soft assertions), or null
	 * @countTarget The locator of every match, used by toHaveCount() when the target is narrowed to its first match, or null
	 */
	function init( required any target, numeric timeout = 5000, any collector, any countTarget ) {
		variables.timeout   = arguments.timeout
		variables.collector = arguments.collector ?: nullValue()
		variables.negate    = false
		variables.java      = isObject( arguments.target ) && structKeyExists( arguments.target, "getJava" ) ? arguments.target.getJava() : arguments.target
		variables.countJava = arguments.countTarget ?: variables.java
		if ( isInstanceOf( variables.java, "com.microsoft.playwright.Page" ) ) {
			variables.kind = "PageAssertions"
		} else if ( isInstanceOf( variables.java, "com.microsoft.playwright.Locator" ) ) {
			variables.kind = "LocatorAssertions"
		} else if ( isInstanceOf( variables.java, "com.microsoft.playwright.APIResponse" ) ) {
			variables.kind = "APIResponseAssertions"
		} else {
			throw(
				type    = "Playwright.InvalidOption",
				message = "expect() needs a page, a locator or an API response.",
				detail  = "Examples: page.expect( ""h1"" ), page.expect(), playwright().expect( page.locator( "".item"" ) )"
			)
		}
		return this
	}

	/**
	 * Negate the next assertion.
	 */
	function not() {
		variables.negate = true
		return this
	}

	/**
	 * --------------------------------------------------------------------------
	 * Page
	 * --------------------------------------------------------------------------
	 */

	/**
	 * @title The exact title, or a regex from regex()
	 */
	function toHaveTitle( required any title ) {
		return check( "toHaveTitle( #describe( arguments.title )# )", ( a, o ) => a.hasTitle( title, o ), "HasTitle" )
	}

	/**
	 * Assert that the page URL equals the given URL or matches the regex.
	 *
	 * @url The full URL, or a regex from regex()
	 */
	function toHaveURL( required any url ) {
		return check( "toHaveURL( #describe( arguments.url )# )", ( a, o ) => a.hasURL( url, o ), "HasURL" )
	}

	/**
	 * --------------------------------------------------------------------------
	 * Locator state
	 * --------------------------------------------------------------------------
	 */

	/**
	 * Assert that the element is visible.
	 *
	 * @return This Expect, for chaining
	 */
	function toBeVisible() {
		return check( "toBeVisible()", ( a, o ) -> a.isVisible( o ), "IsVisible" )
	}

	/**
	 * Assert that the element is hidden or not attached.
	 *
	 * @return This Expect, for chaining
	 */
	function toBeHidden() {
		return check( "toBeHidden()", ( a, o ) -> a.isHidden( o ), "IsHidden" )
	}

	/**
	 * Assert that the element is enabled.
	 *
	 * @return This Expect, for chaining
	 */
	function toBeEnabled() {
		return check( "toBeEnabled()", ( a, o ) -> a.isEnabled( o ), "IsEnabled" )
	}

	/**
	 * Assert that the element is disabled.
	 *
	 * @return This Expect, for chaining
	 */
	function toBeDisabled() {
		return check( "toBeDisabled()", ( a, o ) -> a.isDisabled( o ), "IsDisabled" )
	}

	/**
	 * Assert that the checkbox or radio is checked.
	 *
	 * @return This Expect, for chaining
	 */
	function toBeChecked() {
		return check( "toBeChecked()", ( a, o ) -> a.isChecked( o ), "IsChecked" )
	}

	/**
	 * Assert that the element is editable.
	 *
	 * @return This Expect, for chaining
	 */
	function toBeEditable() {
		return check( "toBeEditable()", ( a, o ) -> a.isEditable( o ), "IsEditable" )
	}

	/**
	 * Assert that the element is empty (no text, or an empty input).
	 *
	 * @return This Expect, for chaining
	 */
	function toBeEmpty() {
		return check( "toBeEmpty()", ( a, o ) -> a.isEmpty( o ), "IsEmpty" )
	}

	/**
	 * Assert that the element has focus.
	 *
	 * @return This Expect, for chaining
	 */
	function toBeFocused() {
		return check( "toBeFocused()", ( a, o ) -> a.isFocused( o ), "IsFocused" )
	}

	/**
	 * Assert that the element is attached to the DOM.
	 *
	 * @return This Expect, for chaining
	 */
	function toBeAttached() {
		return check( "toBeAttached()", ( a, o ) -> a.isAttached( o ), "IsAttached" )
	}

	/**
	 * Assert that the element intersects the viewport.
	 *
	 * @return This Expect, for chaining
	 */
	function toBeInViewport() {
		return check( "toBeInViewport()", ( a, o ) -> a.isInViewport( o ), "IsInViewport" )
	}

	/**
	 * --------------------------------------------------------------------------
	 * Locator content
	 * --------------------------------------------------------------------------
	 */

	/**
	 * Assert that the element's full text equals the given text or matches the regex.
	 *
	 * @text    The full text (whitespace normalized), or a regex from regex()
	 * @options Extra Playwright options, e.g. { useInnerText : true } to ignore hidden text, ignoreCase
	 *
	 * @return This Expect, for chaining
	 */
	function toHaveText( required any text, struct options = {} ) {
		return check( "toHaveText( #describe( arguments.text )# )", ( a, o ) => a.hasText( text, o ), "HasText", arguments.options )
	}

	/**
	 * Assert that the element's text contains the given text or matches the regex.
	 *
	 * @text    A substring, or a regex from regex()
	 * @options Extra Playwright options, e.g. { useInnerText : true } to ignore hidden text, ignoreCase
	 *
	 * @return This Expect, for chaining
	 */
	function toContainText( required any text, struct options = {} ) {
		return check( "toContainText( #describe( arguments.text )# )", ( a, o ) => a.containsText( text, o ), "ContainsText", arguments.options )
	}

	/**
	 * Assert that the input, textarea or select has the given value or a value matching the regex.
	 *
	 * @value The input value, or a regex from regex()
	 */
	function toHaveValue( required any value ) {
		return check( "toHaveValue( #describe( arguments.value )# )", ( a, o ) => a.hasValue( value, o ), "HasValue" )
	}

	/**
	 * Assert that the locator matches exactly the given number of elements.
	 *
	 * @count The number of matching elements
	 */
	function toHaveCount( required numeric count ) {
		var expected = javacast( "int", arguments.count )
		return check(
			"toHaveCount( #arguments.count# )",
			( a, o ) => a.hasCount( expected, o ),
			"HasCount",
			{},
			variables.countJava
		)
	}

	/**
	 * Assert that the element has the attribute with the given value or a value matching the regex.
	 *
	 * @name  The attribute name
	 * @value The attribute value, or a regex from regex()
	 */
	function toHaveAttribute( required string name, required any value ) {
		return check(
			"toHaveAttribute( #arguments.name#, #describe( arguments.value )# )",
			( a, o ) => a.hasAttribute( name, value, o ),
			"HasAttribute"
		)
	}

	/**
	 * Assert that the element's full class attribute equals the given value or matches the regex.
	 *
	 * @className The full class attribute, or a regex from regex()
	 */
	function toHaveClass( required any className ) {
		return check( "toHaveClass( #describe( arguments.className )# )", ( a, o ) => a.hasClass( className, o ), "HasClass" )
	}

	/**
	 * Assert that the element has all of the given classes, ignoring any others.
	 *
	 * @className One or more classes that must be present
	 */
	function toContainClass( required string className ) {
		return check( "toContainClass( #arguments.className# )", ( a, o ) => a.containsClass( className, o ), "ContainsClass" )
	}

	/**
	 * Assert that the element has the given id or an id matching the regex.
	 *
	 * @id The element id
	 */
	function toHaveId( required any id ) {
		return check( "toHaveId( #describe( arguments.id )# )", ( a, o ) => a.hasId( id, o ), "HasId" )
	}

	/**
	 * Assert that the element's computed CSS property has the given value or a value matching the regex.
	 *
	 * @name  The CSS property
	 * @value The computed value, or a regex from regex()
	 */
	function toHaveCSS( required string name, required any value ) {
		return check( "toHaveCSS( #arguments.name#, #describe( arguments.value )# )", ( a, o ) => a.hasCSS( name, value, o ), "HasCSS" )
	}

	/**
	 * Assert that the element's accessible name equals the given name or matches the regex.
	 *
	 * @name The accessible name, or a regex from regex()
	 */
	function toHaveAccessibleName( required any name ) {
		return check( "toHaveAccessibleName( #describe( arguments.name )# )", ( a, o ) => a.hasAccessibleName( name, o ), "HasAccessibleName" )
	}

	/**
	 * Assert that the element has the given ARIA role.
	 *
	 * @role The ARIA role, e.g. button, heading, link
	 */
	function toHaveRole( required string role ) {
		var ariaRole = enumValue( "AriaRole", arguments.role )
		return check( "toHaveRole( #arguments.role# )", ( a, o ) => a.hasRole( ariaRole, o ), "HasRole" )
	}

	/**
	 * Assert that the element's accessibility tree matches the given ARIA snapshot.
	 *
	 * @snapshot The expected ARIA snapshot in YAML, see page.snapshot()
	 */
	function toMatchAriaSnapshot( required string snapshot ) {
		return check( "toMatchAriaSnapshot()", ( a, o ) => a.matchesAriaSnapshot( snapshot, o ), "MatchesAriaSnapshot" )
	}

	/**
	 * --------------------------------------------------------------------------
	 * API responses
	 * --------------------------------------------------------------------------
	 */

	/**
	 * The response status is 2xx.
	 */
	function toBeOK() {
		return check( "toBeOK()", ( a, o ) -> a.isOK(), "" )
	}

	/**
	 * --------------------------------------------------------------------------
	 * Private
	 * --------------------------------------------------------------------------
	 */

	/**
	 * Run one assertion, applying a pending not() and the assertion timeout. On failure it throws
	 * Playwright.AssertionFailed, or appends the message to the soft assertion collector when there is one.
	 *
	 * @label       The assertion description used in failure messages, e.g. toBeVisible()
	 * @assertion   A closure receiving the Playwright assertions object and the options
	 * @optionsName The Playwright options class suffix, e.g. IsVisible, or empty for none
	 * @options     Extra options merged over the assertion timeout
	 * @subject     The Playwright object to assert on, defaults to the target of this Expect
	 *
	 * @return This Expect, for chaining
	 */
	private function check( required string label, required function assertion, required string optionsName, struct options = {}, any subject ) {
		var target = PlaywrightAssertions.assertThat( arguments.subject ?: variables.java )
		var label  = ( variables.negate ? "not()." : "" ) & arguments.label
		if ( variables.negate ) {
			target = target.not()
		}
		variables.negate = false
		var options = len( arguments.optionsName ) ? buildOptions( "assertions.#variables.kind#.#arguments.optionsName#Options", { timeout : variables.timeout }.append( arguments.options ) ) : nullValue()
		var run     = arguments.assertion
		try {
			tryAction( () => run( target, options ), label )
		} catch ( "Playwright.AssertionFailed" e ) {
			if ( isNull( variables.collector ) ) {
				rethrow;
			}
			variables.collector.append( e.message )
		}
		return this
	}

	/**
	 * Describe an expected value for assertion labels: regexes as /pattern/, strings quoted.
	 *
	 * @value The expected value, a string or a regex
	 *
	 * @return The description text
	 */
	private string function describe( any value ) {
		if ( isNull( arguments.value ) ) {
			return "null"
		}
		return isRegex( arguments.value ) ? "/#arguments.value.pattern()#/" : """#arguments.value#"""
	}

}
