/**
 * A browser for AI agents: every action returns the new page state (URL, title and the ai mode
 * accessibility snapshot with element refs), and errors come back as text so the agent can recover.
 * Used by playwright().aiTools() and playwright().aiToolDefinitions().
 *
 * <pre>
 * browser = new models.AiBrowser@bxplaywright( playwright( { baseURL : "http://localhost:8080" } ) )
 * state   = browser.visit( "/login" )           // URL, title and snapshot with refs like e5
 * state   = browser.fill( "e5", "luis@ortus.com" )
 * state   = browser.click( "Sign in" )           // refs or smart selectors
 * browser.close()
 * </pre>
 */
class extends="Base" {

	/**
	 * @manager The playwright() manager to open the page with, or a function returning it (called when the first page opens, so nothing starts before the tools are used)
	 */
	function init( required any manager ) {
		variables.manager = arguments.manager
		return this
	}

	/**
	 * The browser tools in a neutral format: [ { name, description, arguments : { name : description }, handler } ].
	 * The handlers share this browser, so they share one page.
	 *
	 * @return The tool definitions
	 */
	array function toolDefinitions() {
		var browser = this
		return [
			{
				name        : "browser_visit",
				description : "Open a URL in the browser. Returns the URL, title and an accessibility snapshot where elements have refs like e12.",
				arguments   : { url : "Absolute URL, or a path relative to the base URL" },
				handler     : ( target ) => browser.visit( target )
			},
			{
				name        : "browser_snapshot",
				description : "Return the current URL, title and accessibility snapshot with element refs.",
				arguments   : {},
				handler     : () => browser.snapshot()
			},
			{
				name        : "browser_click",
				description : "Click an element. Returns the new page snapshot.",
				arguments   : { target : "An element ref from the snapshot (e.g. e12), or the visible text of a button or link" },
				handler     : ( target ) => browser.click( target )
			},
			{
				name        : "browser_fill",
				description : "Type text into an input. Returns the new page snapshot.",
				arguments   : { target : "An element ref (e.g. e7), or the input label or placeholder", value : "The text to type" },
				handler     : ( target, value ) => browser.fill( target, value )
			},
			{
				name        : "browser_select",
				description : "Choose an option in a select element. Returns the new page snapshot.",
				arguments   : { target : "An element ref, or the select label", value : "The option value or label" },
				handler     : ( target, value ) => browser.select( target, value )
			},
			{
				name        : "browser_press",
				description : "Press a key such as Enter, Tab or Escape. Returns the new page snapshot.",
				arguments   : { key : "The key or combination, e.g. Enter or Control+A" },
				handler     : ( key ) => browser.press( key )
			},
			{
				name        : "browser_back",
				description : "Go back to the previous page. Returns the new page snapshot.",
				arguments   : {},
				handler     : () => browser.back()
			},
			{
				name        : "browser_text",
				description : "Read the visible text of the page or of one element.",
				arguments   : { target : "An element ref or selector, or empty for the whole page" },
				handler     : ( target = "" ) => browser.text( target )
			},
			{
				name        : "browser_screenshot",
				description : "Save a screenshot of the page and return the file path.",
				arguments   : { path : "The file path, e.g. page.png" },
				handler     : ( path ) => browser.screenshot( path )
			},
			{
				name        : "browser_close",
				description : "Close the browser page when the task is done.",
				arguments   : {},
				handler     : () => browser.close()
			}
		]
	}

	/**
	 * The browser tools as bx-ai tools: aiAgent( tools : browser.tools() ).
	 * Requires the bx-ai module.
	 *
	 * @return An array of bx-ai tools
	 */
	array function tools() {
		if ( !getFunctionList().keyExists( "aiTool" ) ) {
			throw(
				type    = "Playwright.NotInstalled",
				message = "aiTools() needs the bx-ai module.",
				detail  = "Install it with: install-bx-module bx-ai. Or use aiToolDefinitions() with another agent framework."
			)
		}
		return toolDefinitions().map( ( definition ) => {
			// autoRegister false: aiTool() would otherwise add each tool to the global registry under its bare name
			var tool = aiTool( definition.name, definition.description, definition.handler, false )
			for ( var argument in definition.arguments ) {
				invoke( tool, "describe" & argument, [ definition.arguments[ argument ] ] )
			}
			return tool
		} )
	}

	/**
	 * Open a URL and return the page state.
	 *
	 * @url Absolute URL, or a path relative to the base URL
	 */
	string function visit( required string url ) {
		var target = arguments.url
		return run( () => currentPage().visit( target ) )
	}

	/**
	 * Return the page state: URL, title and the accessibility snapshot with element refs.
	 */
	string function snapshot() {
		return run( () => nullValue() )
	}

	/**
	 * Click an element and return the page state.
	 *
	 * @target An element ref from the snapshot (e.g. e12) or a smart selector (button text, CSS, @testId)
	 */
	string function click( required string target ) {
		var selector = toSelector( arguments.target )
		return run( () => currentPage().click( selector ) )
	}

	/**
	 * Fill an input and return the page state.
	 *
	 * @target An element ref (e.g. e7), a label, a placeholder or a selector
	 * @value  The text to type
	 */
	string function fill( required string target, required string value ) {
		var selector = toSelector( arguments.target )
		var text     = arguments.value
		return run( () => currentPage().fill( selector, text ) )
	}

	/**
	 * Choose an option in a select element and return the page state.
	 *
	 * @target An element ref, a label or a selector
	 * @value  The option value or label
	 */
	string function select( required string target, required string value ) {
		var selector = toSelector( arguments.target )
		var choice   = arguments.value
		return run( () => currentPage().select( selector, choice ) )
	}

	/**
	 * Press a key (Enter, Tab, Escape, ArrowDown, ...) and return the page state.
	 *
	 * @key The key or combination
	 */
	string function press( required string key ) {
		var combo = arguments.key
		return run( () => currentPage().press( combo ) )
	}

	/**
	 * Go back in history and return the page state.
	 */
	string function back() {
		return run( () => currentPage().back() )
	}

	/**
	 * The visible text of the page or of an element.
	 *
	 * @target An element ref or a selector, empty for the whole page
	 */
	string function text( string target = "" ) {
		try {
			return currentPage().text( len( arguments.target ) ? toSelector( arguments.target ) : "" )
		} catch ( any e ) {
			return errorText( e )
		}
	}

	/**
	 * Save a screenshot and return its path.
	 *
	 * @path The file path
	 */
	string function screenshot( required string path ) {
		try {
			return currentPage().screenshot( arguments.path )
		} catch ( any e ) {
			return errorText( e )
		}
	}

	/**
	 * Close the browser page.
	 */
	string function close() {
		if ( !isNull( variables.page ) ) {
			variables.page.close()
			variables.page = nullValue()
		}
		return "Closed."
	}

	/**
	 * The page the AI tools act on, opening a new one when none is open or the last one was closed.
	 *
	 * @return The current Page, opened on first use
	 */
	function currentPage() {
		if ( isNull( variables.page ) || variables.page.isClosed() ) {
			var manager    = isCustomFunction( variables.manager ) ? variables.manager() : variables.manager
			variables.page = manager.newPage()
		}
		return variables.page
	}

	/**
	 * Run a browser action and describe the resulting page state, or the error if it failed.
	 *
	 * @action A closure performing the browser action
	 *
	 * @return The page URL, title and AI snapshot, or an error text
	 */
	private string function run( required function action ) {
		try {
			arguments.action()
			var page = currentPage()
			return "URL: #page.url()##char( 10 )#Title: #page.title()##char( 10 )##char( 10 )##page.snapshot( options = { mode : "ai" } )#"
		} catch ( any e ) {
			return errorText( e )
		}
	}

	/**
	 * Turn a snapshot ref such as e12 (or f1e2 inside an iframe) into a ref= selector; any other target is returned as is.
	 *
	 * @target A snapshot ref or a selector
	 *
	 * @return A selector Playwright understands
	 */
	private string function toSelector( required string target ) {
		return reFind( "^(f[0-9]+)?e[0-9]+$", arguments.target ) ? "ref=" & arguments.target : arguments.target
	}

	/**
	 * Format an exception as a short error message, including its detail as a fix hint when present.
	 *
	 * @error The caught exception
	 *
	 * @return The error text
	 */
	private string function errorText( required any error ) {
		return "Error [#arguments.error.type ?: "Error"#]: #arguments.error.message#" & ( len( arguments.error.detail ?: "" ) ? " Fix: #arguments.error.detail#" : "" )
	}

}
