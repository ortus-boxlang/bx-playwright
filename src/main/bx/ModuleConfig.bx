/**
 * bx-playwright: fluent browser automation and testing for BoxLang, powered by Microsoft Playwright.
 *
 * - Runtime DSL: the `playwright()` BIF
 * - Component: `bx:playwrightRender`
 * - CLI: `bxPlaywright <verb>` (or `boxlang module:playwright <verb>`)
 *
 * Every setting below can be overridden in `boxlang.json` under `modules.playwright.settings`.
 */
class {

	property name="moduleRecord";
	property name="boxRuntime";
	property name="log";

	this.version      = "@build.version@+@build.number@";
	this.mapping      = "playwright";
	this.author       = "Ortus Solutions";
	this.description  = "Fluent browser automation and testing for BoxLang, powered by Microsoft Playwright";
	this.webURL       = "https://github.com/ortus-boxlang/bx-playwright";
	this.enabled      = true;
	this.dependencies = [];

	/**
	 * Register settings, interceptors and custom interception points.
	 */
	function configure() {
		settings = {
			// Root for the extracted driver, downloaded Node.js and browsers. Empty = ~/.boxlang/playwright
			home              : "",
			// Where browsers are installed. Empty = {home}/browsers
			browsersPath      : "",
			// Explicit Node.js executable. Empty = bundled (full), downloaded, or system node
			nodePath          : "",
			// Node.js version downloaded by `bxPlaywright install` (small distribution)
			nodeVersion       : "@node.version@",
			// Node.js download mirror. Empty = https://nodejs.org/dist
			nodeDownloadURL   : "",
			// Profile used by playwright() when no profile is given
			defaultProfile    : "default",
			// Browser: chromium, firefox or webkit
			browser           : "chromium",
			// Branded browser channel: chrome, chrome-beta, msedge, ...
			channel           : "",
			headless          : true,
			// Milliseconds between actions (debugging)
			slowMo            : 0,
			// Relative URLs in visit() resolve against it
			baseURL           : "",
			viewport          : { width : 1280, height : 720 },
			// Device descriptor name (iPhone 15, Pixel 7, ...). Overrides viewport, user agent and touch
			device            : "",
			locale            : "",
			timezone          : "",
			// light, dark or no-preference
			colorScheme       : "light",
			ignoreHTTPSErrors : false,
			// Milliseconds
			timeouts          : { action : 30000, navigation : 30000, assertion : 5000 },
			// Used by byTestId() and the @name smart selector
			testIdAttribute   : "data-testid",
			// Policies: off, on, only-on-failure, retain-on-failure. Directory empty = {home}/artifacts
			artifacts         : {
				directory  : "",
				screenshot : "off",
				trace      : "off",
				video      : "off"
			},
			// Defaults for bx:playwrightRender and render()
			render            : {
				format          : "A4",
				printBackground : true,
				waitUntil       : "networkidle"
			},
			// Raw passthrough to BrowserType.LaunchOptions and Browser.NewContextOptions
			launchOptions     : {},
			contextOptions    : {},
			// Your own profiles, merged over the built-in ones
			profiles          : {}
		};

		interceptors = [];

		customInterceptionPoints = [
			"onPlaywrightCreate",
			"onBrowserLaunch",
			"onContextCreate",
			"onPageCreate",
			"onPageClose",
			"onPlaywrightAssertionFailure",
			"onPlaywrightArtifact"
		];
	}

	/**
	 * Called when the module is activated.
	 */
	function onLoad() {
		log.info( "bx-playwright loaded (Playwright @playwright.version@, @build.flavor@ distribution)" )
	}

	/**
	 * Called when the module is deactivated.
	 */
	function onUnload() {
	}

	/**
	 * CLI entry point: `bxPlaywright <verb> [options]` or `boxlang module:playwright <verb> [options]`.
	 * Exits the process with the verb's exit code.
	 *
	 * @args The CLI arguments
	 */
	function main( args = [] ) {
		return CLIExit( dispatch( arguments.args ) )
	}

	/**
	 * Run a CLI verb and return its exit code without exiting the process, so it can be tested in-process.
	 *
	 * @args The CLI arguments
	 *
	 * @return The exit code (0 success)
	 */
	numeric function dispatch( args = [] ) {
		return new models.cli.Cli().run( arguments.args )
	}

}
