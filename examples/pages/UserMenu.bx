/**
 * Page component for the user menu of the example app.
 */
class extends="models.PageComponent@playwright" {

	selector = "nav.user"
	elements = { logout : "a.logout" }

	/**
	 * Get the name of the logged in user shown in the menu.
	 *
	 * @return The user name text
	 */
	function name() {
		return text( "span" )
	}

}
